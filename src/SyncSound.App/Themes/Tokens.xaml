<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         SYNC SOUND Design Tokens v3.1
         Palette: Warm Cream (#F7F4ED) + Ink Black (#141417) + Burnt Orange (#E85D3F)
         Tactile Hardware Depth — Zero Flat Surfaces
         ===================================================================== -->

    <!-- Warm Cream Canvas & Recessed Surfaces -->
    <Color x:Key="Color.Canvas.Primary">#F7F4ED</Color>
    <Color x:Key="Color.Canvas.Rail">#F2EEE4</Color>
    <Color x:Key="Color.Canvas.Subtle">#ECE7DA</Color>

    <!-- Tactile Elevated Surfaces -->
    <Color x:Key="Color.Surface.Card">#FFFFFF</Color>
    <Color x:Key="Color.Surface.CardTop">#FFFFFF</Color>
    <Color x:Key="Color.Surface.CardBottom">#FAF7F0</Color>
    <Color x:Key="Color.Surface.Hover">#F3EFE5</Color>
    <Color x:Key="Color.Border.Hairline">#E2DDD0</Color>

    <!-- Ink Hierarchy -->
    <Color x:Key="Color.Ink.Primary">#141417</Color>
    <Color x:Key="Color.Ink.Secondary">#52525B</Color>
    <Color x:Key="Color.Ink.Muted">#84848E</Color>

    <!-- Primary Accent: Burnt Orange -->
    <Color x:Key="Color.Accent.Primary">#E85D3F</Color>
    <Color x:Key="Color.Accent.Hover">#F06E51</Color>
    <Color x:Key="Color.Accent.Pressed">#D94B2D</Color>
    <Color x:Key="Color.Accent.Soft">#16E85D3F</Color>
    <Color x:Key="Color.Accent.Border">#55E85D3F</Color>

    <!-- Semantic Status -->
    <Color x:Key="Color.Status.Success">#10B981</Color>
    <Color x:Key="Color.Status.SuccessSoft">#1810B981</Color>
    <Color x:Key="Color.Status.Warning">#D97706</Color>
    <Color x:Key="Color.Status.WarningSoft">#18F59E0B</Color>
    <Color x:Key="Color.Status.Error">#DC2626</Color>
    <Color x:Key="Color.Status.ErrorSoft">#18EF4444</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="Brush.Canvas.Primary" Color="{StaticResource Color.Canvas.Primary}" />
    <SolidColorBrush x:Key="Brush.Canvas.Rail" Color="{StaticResource Color.Canvas.Rail}" />
    <SolidColorBrush x:Key="Brush.Canvas.Subtle" Color="{StaticResource Color.Canvas.Subtle}" />
    <SolidColorBrush x:Key="Brush.Surface.Card" Color="{StaticResource Color.Surface.Card}" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{StaticResource Color.Surface.Hover}" />
    <SolidColorBrush x:Key="Brush.Border.Hairline" Color="{StaticResource Color.Border.Hairline}" />

    <SolidColorBrush x:Key="Brush.Ink.Primary" Color="{StaticResource Color.Ink.Primary}" />
    <SolidColorBrush x:Key="Brush.Ink.Secondary" Color="{StaticResource Color.Ink.Secondary}" />
    <SolidColorBrush x:Key="Brush.Ink.Muted" Color="{StaticResource Color.Ink.Muted}" />

    <SolidColorBrush x:Key="Brush.Accent.Primary" Color="{StaticResource Color.Accent.Primary}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="{StaticResource Color.Accent.Soft}" />
    <SolidColorBrush x:Key="Brush.Accent.Border" Color="{StaticResource Color.Accent.Border}" />

    <SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource Color.Status.Success}" />
    <SolidColorBrush x:Key="Brush.Status.SuccessSoft" Color="{StaticResource Color.Status.SuccessSoft}" />
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="{StaticResource Color.Status.Warning}" />
    <SolidColorBrush x:Key="Brush.Status.WarningSoft" Color="{StaticResource Color.Status.WarningSoft}" />
    <SolidColorBrush x:Key="Brush.Status.Error" Color="{StaticResource Color.Status.Error}" />
    <SolidColorBrush x:Key="Brush.Status.ErrorSoft" Color="{StaticResource Color.Status.ErrorSoft}" />

    <!-- Layered Non-Flat Tactile Gradients -->
    <LinearGradientBrush x:Key="Brush.Surface.GlassCard" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#FAF7F0" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Surface.InkCard" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1E1E24" Offset="0" />
        <GradientStop Color="#121216" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Border.GlassRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#E6E1D5" Offset="0.4" />
        <GradientStop Color="#D7D1C3" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Border.InkRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#38FFFFFF" Offset="0" />
        <GradientStop Color="#12FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F06E51" Offset="0" />
        <GradientStop Color="#E85D3F" Offset="0.5" />
        <GradientStop Color="#D94B2D" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="Brush.Canvas.AmbientGlow" Center="0.5,0.34" GradientOrigin="0.5,0.34" RadiusX="0.62" RadiusY="0.62">
        <GradientStop Color="#1AE85D3F" Offset="0" />
        <GradientStop Color="#08E85D3F" Offset="0.48" />
        <GradientStop Color="#00F7F4ED" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="Brush.Surface.SphereGlass" Center="0.34,0.24" GradientOrigin="0.30,0.20" RadiusX="0.78" RadiusY="0.78">
        <GradientStop Color="#34343D" Offset="0" />
        <GradientStop Color="#1A1A20" Offset="0.52" />
        <GradientStop Color="#0E0E12" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="Brush.Surface.RailGlass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F5F2EA" Offset="0" />
        <GradientStop Color="#ECE7DC" Offset="1" />
    </LinearGradientBrush>

    <!-- Typography -->
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Editorial">Georgia, Palatino Linotype, Times New Roman</FontFamily>
    <FontFamily x:Key="Font.Body">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Tactile Hardware Elevation Shadows -->
    <DropShadowEffect x:Key="Shadow.SoftCard"
                      BlurRadius="22"
                      ShadowDepth="5"
                      Direction="270"
                      Opacity="0.08"
                      Color="#141417" />

    <DropShadowEffect x:Key="Shadow.HeroButton"
                      BlurRadius="24"
                      ShadowDepth="6"
                      Direction="270"
                      Opacity="0.36"
                      Color="#E85D3F" />

    <DropShadowEffect x:Key="Shadow.Sidebar"
                      BlurRadius="36"
                      ShadowDepth="10"
                      Direction="270"
                      Opacity="0.18"
                      Color="#141417" />

