<UserControl x:Class="SyncSound.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="44,46,44,36" MaxWidth="760">
            <TextBlock Text="PREFERENCES"
                       FontFamily="{StaticResource Font.Mono}"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Accent.Primary}"
                       Margin="0,0,0,4" />
            <TextBlock Text="Settings"
                       FontFamily="{StaticResource Font.Display}"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource Brush.Ink.Primary}"
                       Margin="0,0,0,24" />

            <!-- Quick Sidebar & Shortcut -->
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="24" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Quick Sidebar"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource Brush.Ink.Primary}"
                               Margin="0,0,0,16" />

                    <!-- Global Shortcut -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Global keyboard shortcut"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Ink.Primary}" />
                            <TextBlock Text="Summon or hide the Quick Sidebar from any app (e.g. Ctrl+Shift+S)"
                                       FontSize="12.5"
                                       Foreground="{StaticResource Brush.Ink.Secondary}"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding ShortcutStatusMessage}"
                                       FontSize="12"
                                       Foreground="{StaticResource Brush.Accent.Pressed}"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasShortcutStatus, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Text="{Binding ShortcutInput, UpdateSourceTrigger=PropertyChanged}"
                                     Width="148"
                                     Padding="12,8"
                                     FontFamily="{StaticResource Font.Mono}"
                                     FontSize="12.5"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource Brush.Ink.Primary}"
                                     CaretBrush="{StaticResource Brush.Accent.Primary}"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="{StaticResource Brush.Border.Hairline}"
                                     BorderThickness="1.2"
                                     Background="#FFFFFF"
                                     Margin="0,0,8,0" />
                            <Button Content="Apply"
                                    Style="{StaticResource SecondaryPillButtonStyle}"
                                    Command="{Binding ApplyShortcutCommand}"
                                    Padding="16,8" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{StaticResource Brush.Border.Hairline}" Margin="0,0,0,16" />

                    <!-- Always on Top -->
                    <DockPanel Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Keep sidebar on top" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Brush.Ink.Primary}" />
                            <TextBlock Text="Float above fullscreen video and games while open" FontSize="12.5" Foreground="{StaticResource Brush.Ink.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right"
                                  HorizontalAlignment="Right"
                                  Style="{StaticResource PillToggleSwitchStyle}"
                                  IsChecked="{Binding SidebarAlwaysOnTop, Mode=TwoWay}" />
                    </DockPanel>

                    <!-- Click Outside -->
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="Auto-dismiss on click outside" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Brush.Ink.Primary}" />
                            <TextBlock Text="Automatically tuck away when you return to your app" FontSize="12.5" Foreground="{StaticResource Brush.Ink.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right"
                                  HorizontalAlignment="Right"
                                  Style="{StaticResource PillToggleSwitchStyle}"
                                  IsChecked="{Binding SidebarClickOutsideToClose, Mode=TwoWay}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Audio & System Behavior -->
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="24" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Audio &amp; System"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource Brush.Ink.Primary}"
                               Margin="0,0,0,16" />

                    <DockPanel Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Remember preferred headphones" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Brush.Ink.Primary}" />
                            <TextBlock Text="Automatically arm your saved headphones whenever they connect" FontSize="12.5" Foreground="{StaticResource Brush.Ink.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right"
                                  HorizontalAlignment="Right"
                                  Style="{StaticResource PillToggleSwitchStyle}"
                                  IsChecked="{Binding AutoSelectPreferredDevices, Mode=TwoWay}" />
                    </DockPanel>

                    <Border Height="1" Background="{StaticResource Brush.Border.Hairline}" Margin="0,0,0,16" />

                    <DockPanel Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Close to system tray" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Brush.Ink.Primary}" />
                            <TextBlock Text="Keep audio sharing and your global shortcut active in the background" FontSize="12.5" Foreground="{StaticResource Brush.Ink.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right"
                                  HorizontalAlignment="Right"
                                  Style="{StaticResource PillToggleSwitchStyle}"
                                  IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                    </DockPanel>

                    <DockPanel Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Launch at Windows sign-in" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Brush.Ink.Primary}" />
                            <TextBlock Text="Start SYNC SOUND automatically when you turn on your PC" FontSize="12.5" Foreground="{StaticResource Brush.Ink.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right"
                                  HorizontalAlignment="Right"
                                  Style="{StaticResource PillToggleSwitchStyle}"
                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                    </DockPanel>

                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="Start minimized to tray" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Brush.Ink.Primary}" />
                            <TextBlock Text="Open silently in the notification area on startup" FontSize="12.5" Foreground="{StaticResource Brush.Ink.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right"
                                  HorizontalAlignment="Right"
                                  Style="{StaticResource PillToggleSwitchStyle}"
                                  IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Sync & Diagnostics (Hidden Behind Expander) -->
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="24">
                <Expander IsExpanded="{Binding DiagnosticsExpanded, Mode=TwoWay}"
                          Header="Sync &amp; Diagnostics"
                          FontSize="15"
                          FontWeight="Bold"
                          Foreground="{StaticResource Brush.Ink.Primary}">
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="Fine-tune per-device delay compensation if wired speakers play ahead of Bluetooth earbuds, or inspect live audio engine metrics."
                                   FontSize="12.5"
                                   FontWeight="Normal"
                                   Foreground="{StaticResource Brush.Ink.Secondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />

                        <ItemsControl ItemsSource="{Binding DelaySettings}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DeviceName}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource Brush.Ink.Primary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Slider Grid.Column="1"
                                                Style="{StaticResource MinimalSliderStyle}"
                                                Minimum="0"
                                                Maximum="300"
                                                Value="{Binding DelayMs, Mode=TwoWay}"
                                                Margin="12,0" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DelayLabel}"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Ink.Secondary}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding DiagnosticOutputs}" Margin="0,0,0,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Brush.Canvas.Subtle}"
                                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="12,9"
                                            Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Ink.Primary}">
                                                <Run Text="{Binding Name}" />
                                                <Run Text=" · " Foreground="{StaticResource Brush.Ink.Muted}" />
                                                <Run Text="{Binding State}" Foreground="{StaticResource Brush.Accent.Pressed}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Metrics}"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="11"
                                                       FontWeight="Normal"
                                                       Foreground="{StaticResource Brush.Ink.Secondary}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Open logs folder"
                                        Style="{StaticResource SecondaryPillButtonStyle}"
                                        Command="{Binding OpenLogsFolderCommand}"
                                        Margin="0,0,8,0" />
                                <Button Content="Windows Sound Settings"
                                        Style="{StaticResource SecondaryPillButtonStyle}"
                                        Command="{Binding OpenSoundSettingsCommand}" />
                            </StackPanel>

                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding AppVersion}"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="11.5"
                                       FontWeight="Normal"
                                       Foreground="{StaticResource Brush.Ink.Muted}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
