<UserControl x:Class="SyncSound.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="42,46,42,36" MaxWidth="780">
            <TextBlock Text="Preferences"
                       FontFamily="{StaticResource Font.Display}"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Ink.Primary}" />
            <TextBlock Text="Personalize your appearance, shortcut, and listening behavior."
                       FontSize="14.5"
                       Foreground="{DynamicResource Brush.Ink.Secondary}"
                       Margin="0,4,0,24" />

            <!-- Appearance (Light / Dark / System with Visual Theme Previews) -->
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="24" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Appearance"
                               FontFamily="{StaticResource Font.Display}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Ink.Primary}" />
                    <TextBlock Text="Choose how SYNC SOUND looks across windows and your Quick Sidebar."
                               FontSize="13.5"
                               Foreground="{DynamicResource Brush.Ink.Secondary}"
                               Margin="0,3,0,18" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Light Theme Card -->
                        <RadioButton Grid.Column="0"
                                     GroupName="ThemeMode"
                                     IsChecked="{Binding IsLightTheme, Mode=TwoWay}"
                                     Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Card"
                                            Background="{DynamicResource Brush.Canvas.Subtle}"
                                            BorderBrush="{DynamicResource Brush.Border.Hairline}"
                                            BorderThickness="1.5"
                                            CornerRadius="16"
                                            Padding="14">
                                        <StackPanel>
                                            <Border Height="54" CornerRadius="10" Background="#F4EFE6" BorderBrush="#DFD8CA" BorderThickness="1" Margin="0,0,0,10">
                                                <StackPanel Margin="10" VerticalAlignment="Center">
                                                    <Border Height="7" Width="56" CornerRadius="3.5" Background="#191817" HorizontalAlignment="Left" Margin="0,0,0,6" />
                                                    <Border Height="6" Width="36" CornerRadius="3" Background="#C65D32" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="Light" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink.Primary}" />
                                            <TextBlock Text="Warm cream" FontSize="12" Foreground="{DynamicResource Brush.Ink.Secondary}" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Dark Theme Card -->
                        <RadioButton Grid.Column="2"
                                     GroupName="ThemeMode"
                                     IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                     Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Card"
                                            Background="{DynamicResource Brush.Canvas.Subtle}"
                                            BorderBrush="{DynamicResource Brush.Border.Hairline}"
                                            BorderThickness="1.5"
                                            CornerRadius="16"
                                            Padding="14">
                                        <StackPanel>
                                            <Border Height="54" CornerRadius="10" Background="#191817" BorderBrush="#34302C" BorderThickness="1" Margin="0,0,0,10">
                                                <StackPanel Margin="10" VerticalAlignment="Center">
                                                    <Border Height="7" Width="56" CornerRadius="3.5" Background="#F4EFE6" HorizontalAlignment="Left" Margin="0,0,0,6" />
                                                    <Border Height="6" Width="36" CornerRadius="3" Background="#C65D32" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="Dark" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink.Primary}" />
                                            <TextBlock Text="Deep charcoal" FontSize="12" Foreground="{DynamicResource Brush.Ink.Secondary}" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- System Theme Card -->
                        <RadioButton Grid.Column="4"
                                     GroupName="ThemeMode"
                                     IsChecked="{Binding IsSystemTheme, Mode=TwoWay}"
                                     Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Card"
                                            Background="{DynamicResource Brush.Canvas.Subtle}"
                                            BorderBrush="{DynamicResource Brush.Border.Hairline}"
                                            BorderThickness="1.5"
                                            CornerRadius="16"
                                            Padding="14">
                                        <StackPanel>
                                            <Border Height="54" CornerRadius="10" BorderBrush="#DFD8CA" BorderThickness="1" Margin="0,0,0,10" ClipToBounds="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="#F4EFE6" />
                                                    <Border Grid.Column="1" Background="#191817" />
                                                    <Border Grid.ColumnSpan="2" Width="28" Height="8" CornerRadius="4" Background="#C65D32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="System" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink.Primary}" />
                                            <TextBlock Text="Follow Windows" FontSize="12" Foreground="{DynamicResource Brush.Ink.Secondary}" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Quick Access & Sidebar -->
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="24" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Quick Sidebar"
                               FontFamily="{StaticResource Font.Display}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Ink.Primary}"
                               Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Global keyboard shortcut"
                                       FontSize="14.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Ink.Primary}" />
                            <TextBlock Text="Open or hide the Quick Sidebar from any app (e.g. Ctrl+Shift+S)"
                                       FontSize="13"
                                       Foreground="{DynamicResource Brush.Ink.Secondary}"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding ShortcutStatusMessage}"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource Brush.Accent.Primary}"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasShortcutStatus, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Text="{Binding ShortcutInput, UpdateSourceTrigger=PropertyChanged}"
                                     Width="150"
                                     Padding="12,8"
                                     FontFamily="{StaticResource Font.Mono}"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource Brush.Ink.Primary}"
                                     CaretBrush="{DynamicResource Brush.Accent.Primary}"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="{DynamicResource Brush.Border.Hairline}"
                                     BorderThickness="1.2"
                                     Background="{DynamicResource Brush.Surface.Card}"
                                     Margin="0,0,8,0" />
                            <Button Content="Apply"
                                    Style="{StaticResource SecondaryPillButtonStyle}"
                                    Command="{Binding ApplyShortcutCommand}"
                                    Padding="16,8" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource Brush.Border.Hairline}" Margin="0,0,0,16" />

                    <DockPanel Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Keep sidebar on top" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink.Primary}" />
                            <TextBlock Text="Float above movies and games while open" FontSize="13" Foreground="{DynamicResource Brush.Ink.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right"
                                  HorizontalAlignment="Right"
                                  Style="{StaticResource PillToggleSwitchStyle}"
                                  IsChecked="{Binding SidebarAlwaysOnTop, Mode=TwoWay}" />
                    </DockPanel>

                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="Close when clicking outside" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink.Primary}" />
                            <TextBlock Text="Automatically tuck away when you return to your app" FontSize="13" Foreground="{DynamicResource Brush.Ink.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right"
                                  HorizontalAlignment="Right"
                                  Style="{StaticResource PillToggleSwitchStyle}"
                                  IsChecked="{Binding SidebarClickOutsideToClose, Mode=TwoWay}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Listening & Application Behavior -->
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="24" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Listening &amp; behavior"
                               FontFamily="{StaticResource Font.Display}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Ink.Primary}"
                               Margin="0,0,0,16" />

                    <DockPanel Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Remember preferred headphones" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink.Primary}" />
                            <TextBlock Text="Automatically include your saved headphones when they connect" FontSize="13" Foreground="{DynamicResource Brush.Ink.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right"
                                  HorizontalAlignment="Right"
                                  Style="{StaticResource PillToggleSwitchStyle}"
                                  IsChecked="{Binding AutoSelectPreferredDevices, Mode=TwoWay}" />
                    </DockPanel>

                    <Border Height="1" Background="{DynamicResource Brush.Border.Hairline}" Margin="0,0,0,16" />

                    <DockPanel Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Close to system tray" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink.Primary}" />
                            <TextBlock Text="Keep listening and your global shortcut active in the background" FontSize="13" Foreground="{DynamicResource Brush.Ink.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right"
                                  HorizontalAlignment="Right"
                                  Style="{StaticResource PillToggleSwitchStyle}"
                                  IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                    </DockPanel>

                    <DockPanel Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Start with Windows" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink.Primary}" />
                            <TextBlock Text="Launch SYNC SOUND automatically when you sign in" FontSize="13" Foreground="{DynamicResource Brush.Ink.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right"
                                  HorizontalAlignment="Right"
                                  Style="{StaticResource PillToggleSwitchStyle}"
                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                    </DockPanel>

                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="Start minimized to tray" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink.Primary}" />
                            <TextBlock Text="Open quietly in the notification area on startup" FontSize="13" Foreground="{DynamicResource Brush.Ink.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right"
                                  HorizontalAlignment="Right"
                                  Style="{StaticResource PillToggleSwitchStyle}"
                                  IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Diagnostics (Collapsed by Default) -->
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="24">
                <Expander IsExpanded="{Binding DiagnosticsExpanded, Mode=TwoWay}"
                          Header="Diagnostics &amp; Sync Calibration"
                          FontSize="15.5"
                          FontWeight="Bold"
                          Foreground="{DynamicResource Brush.Ink.Primary}">
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="Fine-tune per-device delay compensation if wired speakers play ahead of Bluetooth earbuds, or inspect live metrics."
                                   FontSize="13"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource Brush.Ink.Secondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />

                        <ItemsControl ItemsSource="{Binding DelaySettings}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DeviceName}"
                                                   FontSize="13.5"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource Brush.Ink.Primary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Slider Grid.Column="1"
                                                Style="{StaticResource MinimalSliderStyle}"
                                                Minimum="0"
                                                Maximum="300"
                                                Value="{Binding DelayMs, Mode=TwoWay}"
                                                Margin="12,0" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DelayLabel}"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Ink.Secondary}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding DiagnosticOutputs}" Margin="0,0,0,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Brush.Canvas.Subtle}"
                                            BorderBrush="{DynamicResource Brush.Border.Hairline}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="12,9"
                                            Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink.Primary}">
                                                <Run Text="{Binding Name}" />
                                                <Run Text=" · " Foreground="{DynamicResource Brush.Ink.Muted}" />
                                                <Run Text="{Binding State}" Foreground="{DynamicResource Brush.Accent.Primary}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Metrics}"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="11.5"
                                                       FontWeight="Normal"
                                                       Foreground="{DynamicResource Brush.Ink.Secondary}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Open logs folder"
                                        Style="{StaticResource SecondaryPillButtonStyle}"
                                        Command="{Binding OpenLogsFolderCommand}"
                                        Margin="0,0,8,0" />
                                <Button Content="Windows Sound Settings"
                                        Style="{StaticResource SecondaryPillButtonStyle}"
                                        Command="{Binding OpenSoundSettingsCommand}" />
                            </StackPanel>

                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding AppVersion}"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="12"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource Brush.Ink.Muted}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
