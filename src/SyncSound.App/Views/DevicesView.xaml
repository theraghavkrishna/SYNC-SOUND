<UserControl x:Class="SyncSound.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SyncSound.App.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="DeviceCardTemplate">
            <ContentControl Style="{StaticResource CardSurfaceStyle}"
                            Width="372"
                            Margin="0,0,14,14"
                            Padding="18,16"
                            ToolTip="{Binding FullSystemName}">
                <ContentControl.BorderBrush>
                    <PriorityBinding>
                        <Binding Path="IsSelected" FallbackValue="{x:Null}" />
                    </PriorityBinding>
                </ContentControl.BorderBrush>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Row: Silhouette + Transport / Battery / Join Pill -->
                    <DockPanel Grid.Row="0">
                        <Border Width="48" Height="48" CornerRadius="14" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Canvas.Subtle}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Hairline}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Border}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Path Data="{Binding DeviceIconGeometry}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="22" Height="22" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Stroke" Value="{DynamicResource Brush.Ink.Secondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource Brush.Accent.Primary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Border>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
                            <!-- Real Battery Pill (Never fabricated) -->
                            <Border CornerRadius="10"
                                    Padding="8,4"
                                    Margin="0,0,7,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Status.SuccessSoft}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLowBattery}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Status.WarningSoft}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Battery}"
                                          Stroke="{DynamicResource Brush.Status.Success}"
                                          StrokeThickness="1.5"
                                          Width="12" Height="12" Stretch="Uniform"
                                          Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding BatteryText}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Status.Success}" />
                                </StackPanel>
                            </Border>

                            <!-- Join / In group pill -->
                            <Button Command="{Binding ToggleCommand}" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="14" Padding="12,5" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Canvas.Subtle}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Hairline}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Icon.Check}"
                                                      Stroke="#FCFBF8"
                                                      StrokeThickness="2"
                                                      Width="11" Height="11" Stretch="Uniform"
                                                      Margin="0,0,5,0"
                                                      Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBlock FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Join" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Primary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Text" Value="In group" />
                                                                    <Setter Property="Foreground" Value="#FCFBF8" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- Middle Row: Identity + Mute + Rotary Knob -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Ink.Primary}"
                                       TextTrimming="CharacterEllipsis" />
                            <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="6.5" Height="6.5" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Status.Success}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActivelyPlaying}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Accent.Primary}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding CategoryLabel}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource Brush.Ink.Secondary}" />
                                <Border Background="{DynamicResource Brush.Canvas.Subtle}"
                                        CornerRadius="6"
                                        Padding="6,1.5"
                                        Margin="7,0,0,0"
                                        Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Default"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Ink.Secondary}" />
                                </Border>
                                <Border Background="{DynamicResource Brush.Accent.Soft}"
                                        CornerRadius="6"
                                        Padding="6,1.5"
                                        Margin="6,0,0,0"
                                        Visibility="{Binding IsActivelyPlaying, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Active"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Accent.Primary}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Brush.Status.Error}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding ToggleMuteCommand}"
                                Style="{StaticResource QuietButtonStyle}"
                                VerticalAlignment="Center"
                                Padding="7"
                                Margin="0,0,4,0"
                                ToolTip="Mute / unmute this device">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.Ink.Secondary}"
                                  StrokeThickness="1.75"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource Icon.Volume}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeviceMuted}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource Icon.Mute}" />
                                                <Setter Property="Stroke" Value="{DynamicResource Brush.Accent.Primary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>

                        <controls:RotaryVolumeKnob Grid.Column="2"
                                                   Value="{Binding Volume, Mode=TwoWay}"
                                                   ToolTip="Drag up/down or scroll to adjust individual device volume" />
                    </Grid>
                </Grid>
            </ContentControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="34,42,34,24" MaxWidth="1120" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Your headphones."
                           FontFamily="{StaticResource Font.Display}"
                           FontSize="32"
                           FontWeight="Bold"
                           TextOptions.TextFormattingMode="Ideal"
                           Foreground="{DynamicResource Brush.Ink.Primary}" />
                <TextBlock Text="{Binding SelectionSummary}"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="{DynamicResource Brush.Ink.Secondary}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <Button Content="Refresh"
                        Style="{StaticResource SecondaryPillButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Select all"
                        Style="{StaticResource SecondaryPillButtonStyle}"
                        Command="{Binding SelectAllCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Add headphones"
                        Style="{StaticResource PrimaryPillButtonStyle}"
                        Padding="20,10"
                        FontSize="13.5"
                        Command="{Binding AddHeadphonesCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- Truthful Handoff Banner -->
        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Accent.Soft}"
                BorderBrush="{DynamicResource Brush.Accent.Border}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14,10"
                Margin="0,0,0,16"
                Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding BannerMessage}"
                       FontSize="13"
                       FontWeight="Medium"
                       Foreground="{DynamicResource Brush.Accent.Primary}" />
        </Border>

        <!-- Grouped Collection Atelier -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Group 1: In Listening Group -->
                <StackPanel Visibility="{Binding HasSelectedGroupDevices, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,16">
                    <TextBlock Text="IN LISTENING GROUP"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Accent.Primary}"
                               Margin="2,0,0,10" />
                    <ItemsControl ItemsSource="{Binding SelectedGroupDevices}" ItemTemplate="{StaticResource DeviceCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- Group 2: Connected & Available -->
                <StackPanel Visibility="{Binding HasAvailableDevices, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,16">
                    <TextBlock Text="CONNECTED &amp; AVAILABLE"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Ink.Muted}"
                               Margin="2,0,0,10" />
                    <ItemsControl ItemsSource="{Binding AvailableDevices}" ItemTemplate="{StaticResource DeviceCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- Discovery / Add Another Output Card -->
                <ContentControl Style="{StaticResource CardSurfaceStyle}" MaxWidth="720" HorizontalAlignment="Left" Padding="24,20" Margin="0,4,0,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Open Windows Bluetooth"
                                Style="{StaticResource SecondaryPillButtonStyle}"
                                Command="{Binding AddHeadphonesCommand}"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Bring another headphone in."
                                       FontFamily="{StaticResource Font.Display}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Ink.Primary}" />
                            <TextBlock Text="Pair a Bluetooth headset or plug in wired 3.5 mm or USB audio in Windows — SYNC SOUND discovers it automatically."
                                       FontSize="13"
                                       Foreground="{DynamicResource Brush.Ink.Secondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
