<UserControl x:Class="SyncSound.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SyncSound.App.Controls">
    <Grid>
        <Grid Margin="36,42,36,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,22">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Your headphones. Your listening group."
                               FontFamily="{StaticResource Font.Display}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Ink.Primary}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Choose who joins the sound."
                                   FontSize="14.5"
                                   Foreground="{DynamicResource Brush.Ink.Secondary}" />
                        <TextBlock Text="  ·  "
                                   FontSize="14.5"
                                   Foreground="{DynamicResource Brush.Ink.Muted}" />
                        <TextBlock Text="{Binding SelectionSummary}"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Accent.Primary}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <Button Content="Refresh"
                            Style="{StaticResource SecondaryPillButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="Select all"
                            Style="{StaticResource SecondaryPillButtonStyle}"
                            Command="{Binding SelectAllCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="Add headphones"
                            Style="{StaticResource PrimaryPillButtonStyle}"
                            Padding="20,10"
                            FontSize="13.5"
                            Command="{Binding AddHeadphonesCommand}" />
                </StackPanel>
            </DockPanel>

            <!-- Truthful Handoff / Notice Banner -->
            <Border Grid.Row="1"
                    Background="{DynamicResource Brush.Accent.Soft}"
                    BorderBrush="{DynamicResource Brush.Accent.Border}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,10"
                    Margin="0,0,0,16"
                    Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding BannerMessage}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource Brush.Accent.Primary}" />
            </Border>

            <!-- Responsive Collection Grid -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="336"
                                    Padding="18,16"
                                    Margin="0,0,14,14"
                                    CornerRadius="20"
                                    Background="{DynamicResource Brush.Surface.ElevatedCard}"
                                    Effect="{DynamicResource Shadow.SoftCard}"
                                    ToolTip="{Binding FullSystemName}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Hairline}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Border}" />
                                                <Setter Property="BorderThickness" Value="1.4" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Silhouette + Check Pill -->
                                    <DockPanel Grid.Row="0">
                                        <Border Width="48"
                                                Height="48"
                                                CornerRadius="14"
                                                BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Canvas.Subtle}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Hairline}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Border}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Path Data="{Binding DeviceIconGeometry}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="22" Height="22" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Stroke" Value="{DynamicResource Brush.Ink.Secondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Stroke" Value="{DynamicResource Brush.Accent.Primary}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Border>

                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
                                            <!-- Real Battery Pill -->
                                            <Border Background="{DynamicResource Brush.Status.SuccessSoft}"
                                                    CornerRadius="10"
                                                    Padding="8,4"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Icon.Battery}"
                                                          Stroke="{DynamicResource Brush.Status.Success}"
                                                          StrokeThickness="1.5"
                                                          Width="12" Height="12" Stretch="Uniform"
                                                          Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding BatteryText}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.Status.Success}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Join / Selected Pill Button -->
                                            <Button Command="{Binding ToggleCommand}" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Pill"
                                                                CornerRadius="14"
                                                                Padding="12,5"
                                                                BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Canvas.Subtle}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Hairline}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{StaticResource Icon.Check}"
                                                                      Stroke="#FCFBF8"
                                                                      StrokeThickness="2"
                                                                      Width="11" Height="11" Stretch="Uniform"
                                                                      Margin="0,0,5,0"
                                                                      Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <TextBlock FontSize="12" FontWeight="SemiBold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="Join" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Primary}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter Property="Text" Value="In group" />
                                                                                    <Setter Property="Foreground" Value="#FCFBF8" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Bottom Row: Friendly Identity + Per-Device Knob -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="16.5"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.Ink.Primary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Ellipse Width="6.5" Height="6.5" Fill="{DynamicResource Brush.Status.Success}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding CategoryLabel}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource Brush.Ink.Secondary}" />
                                                <Border Background="{DynamicResource Brush.Canvas.Subtle}"
                                                        CornerRadius="6"
                                                        Padding="6,1.5"
                                                        Margin="8,0,0,0"
                                                        Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="Default"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.Ink.Secondary}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ErrorMessage}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Brush.Status.Error}"
                                                       Margin="0,4,0,0"
                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>

                                        <controls:RotaryVolumeKnob Grid.Column="1"
                                                                   DialSize="38"
                                                                   Width="44"
                                                                   Height="52"
                                                                   Value="{Binding Volume, Mode=TwoWay}"
                                                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Intentional Empty State -->
            <Border Grid.Row="2"
                    Style="{StaticResource SurfaceCardStyle}"
                    Padding="40"
                    Visibility="{Binding HasDevices, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="390">
                    <Border Width="72"
                            Height="72"
                            CornerRadius="22"
                            Background="{DynamicResource Brush.Canvas.Subtle}"
                            BorderBrush="{DynamicResource Brush.Border.Hairline}"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,18">
                        <Path Data="{StaticResource Icon.Headphones}"
                              Stroke="{DynamicResource Brush.Ink.Muted}"
                              StrokeThickness="1.75"
                              Width="32"
                              Height="32"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Your listening group starts here."
                               FontFamily="{StaticResource Font.Display}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Ink.Primary}"
                               TextAlignment="Center" />
                    <TextBlock Text="Connect headphones to Windows, then find them here."
                               FontSize="14.5"
                               Foreground="{DynamicResource Brush.Ink.Secondary}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,8,0,22" />
                    <Button Content="Add headphones"
                            Style="{StaticResource PrimaryPillButtonStyle}"
                            Command="{Binding AddHeadphonesCommand}"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
