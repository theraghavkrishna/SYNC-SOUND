<UserControl x:Class="SyncSound.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,32,40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,22">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Your headphones"
                           FontFamily="{StaticResource Font.Display}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Ink.Primary}" />
                <TextBlock Text="{Binding SelectionSummary}"
                           FontSize="14"
                           Foreground="{StaticResource Brush.Ink.Secondary}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <Button Content="Refresh"
                        Style="{StaticResource SecondaryPillButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Select all"
                        Style="{StaticResource SecondaryPillButtonStyle}"
                        Command="{Binding SelectAllCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Add headphones"
                        Style="{StaticResource PrimaryPillButtonStyle}"
                        Padding="20,10"
                        FontSize="13.5"
                        Command="{Binding AddHeadphonesCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- Optional Notice -->
        <Border Grid.Row="1"
                Background="{StaticResource Brush.Accent.Soft}"
                BorderBrush="{StaticResource Brush.Accent.Border}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,10"
                Margin="0,0,0,16"
                Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding BannerMessage}"
                       FontSize="13"
                       Foreground="{StaticResource Brush.Accent.Primary}" />
        </Border>

        <!-- Device Cards -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SurfaceCardStyle}"
                                Padding="20,16"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Device Icon Tile -->
                                <Border Grid.Column="0"
                                        Width="48"
                                        Height="48"
                                        CornerRadius="14"
                                        Background="{StaticResource Brush.Canvas.Primary}"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Headphones}"
                                          Stroke="{StaticResource Brush.Ink.Primary}"
                                          StrokeThickness="1.75"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="22"
                                          Height="22"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>

                                <!-- Name & Clean Status -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="15.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Ink.Primary}"
                                                   VerticalAlignment="Center" />
                                        <Border Background="{StaticResource Brush.Accent.Soft}"
                                                CornerRadius="8"
                                                Padding="8,3"
                                                Margin="10,0,0,0"
                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Playing original sound"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Accent.Primary}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.Status.Success}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding StatusBadge}"
                                                   FontSize="12.5"
                                                   Foreground="{StaticResource Brush.Ink.Secondary}" />
                                        <TextBlock Text=" · "
                                                   FontSize="12.5"
                                                   Foreground="{StaticResource Brush.Ink.Muted}" />
                                        <TextBlock Text="{Binding CategoryLabel}"
                                                   FontSize="12.5"
                                                   Foreground="{StaticResource Brush.Ink.Muted}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding ErrorMessage}"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.Status.Error}"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>

                                <!-- Selection Switch -->
                                <CheckBox Grid.Column="2"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Style="{StaticResource PillToggleSwitchStyle}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="{Binding Name}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty State -->
        <Border Grid.Row="2"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="40"
                Visibility="{Binding HasDevices, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380">
                <Border Width="72"
                        Height="72"
                        CornerRadius="22"
                        Background="{StaticResource Brush.Canvas.Primary}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,18">
                    <Path Data="{StaticResource Icon.Headphones}"
                          Stroke="{StaticResource Brush.Ink.Muted}"
                          StrokeThickness="1.75"
                          Width="32"
                          Height="32"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Let's connect some headphones."
                           FontFamily="{StaticResource Font.Display}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Ink.Primary}"
                           TextAlignment="Center" />
                <TextBlock Text="Connect Bluetooth earbuds or plug in headphones using Windows Settings, then click Refresh."
                           FontSize="13.5"
                           Foreground="{StaticResource Brush.Ink.Secondary}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,8,0,22" />
                <Button Content="Open Bluetooth Settings"
                        Style="{StaticResource PrimaryPillButtonStyle}"
                        Command="{Binding AddHeadphonesCommand}"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
