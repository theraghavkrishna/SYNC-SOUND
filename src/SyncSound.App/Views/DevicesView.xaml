<UserControl x:Class="SyncSound.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SyncSound.App.Controls">
    <Grid Margin="42,46,42,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,22">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Your headphones. Your listening group."
                           FontFamily="{StaticResource Font.Display}"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Ink.Primary}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Choose who joins the sound."
                               FontSize="14.5"
                               Foreground="{DynamicResource Brush.Ink.Secondary}" />
                    <TextBlock Text="  ·  "
                               FontSize="14.5"
                               Foreground="{DynamicResource Brush.Ink.Muted}" />
                    <TextBlock Text="{Binding SelectionSummary}"
                               FontSize="14.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Accent.Primary}" />
                </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <Button Content="Refresh"
                        Style="{StaticResource SecondaryPillButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Select all"
                        Style="{StaticResource SecondaryPillButtonStyle}"
                        Command="{Binding SelectAllCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Add headphones"
                        Style="{StaticResource PrimaryPillButtonStyle}"
                        Padding="20,10"
                        FontSize="13.5"
                        Command="{Binding AddHeadphonesCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- Truthful Handoff / Notice Banner -->
        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Accent.Soft}"
                BorderBrush="{DynamicResource Brush.Accent.Border}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14,10"
                Margin="0,0,0,16"
                Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding BannerMessage}"
                       FontSize="13"
                       FontWeight="Medium"
                       Foreground="{DynamicResource Brush.Accent.Primary}" />
        </Border>

        <!-- Device Collection -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="20,16"
                                Margin="0,0,0,12"
                                CornerRadius="20"
                                Background="{DynamicResource Brush.Surface.ElevatedCard}"
                                Effect="{DynamicResource Shadow.SoftCard}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Hairline}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Vector Device Silhouette -->
                                <Border Grid.Column="0"
                                        Width="52"
                                        Height="52"
                                        CornerRadius="15"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Canvas.Subtle}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Hairline}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Border}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Path Data="{Binding DeviceIconGeometry}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="23"
                                          Height="23"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Stroke" Value="{DynamicResource Brush.Ink.Secondary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Stroke" Value="{DynamicResource Brush.Accent.Primary}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Border>

                                <!-- Friendly Name, Category, Real Battery & Status -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Ink.Primary}"
                                                   VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource Brush.Accent.Soft}"
                                                BorderBrush="{DynamicResource Brush.Accent.Border}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="8,3"
                                                Margin="10,0,0,0"
                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Original sound"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Accent.Primary}" />
                                        </Border>
                                        <Border Background="{DynamicResource Brush.Status.SuccessSoft}"
                                                CornerRadius="8"
                                                Padding="8,3"
                                                Margin="8,0,0,0"
                                                Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Icon.Battery}"
                                                      Stroke="{DynamicResource Brush.Status.Success}"
                                                      StrokeThickness="1.5"
                                                      Width="13" Height="13" Stretch="Uniform"
                                                      Margin="0,0,5,0" />
                                                <TextBlock Text="{Binding BatteryText}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Status.Success}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Status.Success}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding StatusBadge}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Brush.Ink.Secondary}" />
                                        <TextBlock Text=" · "
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Brush.Ink.Muted}" />
                                        <TextBlock Text="{Binding CategoryLabel}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Brush.Ink.Muted}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding ErrorMessage}"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource Brush.Status.Error}"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>

                                <!-- Per-Device Rotary Volume Knob -->
                                <controls:RotaryVolumeKnob Grid.Column="2"
                                                           DialSize="42"
                                                           Value="{Binding Volume, Mode=TwoWay}"
                                                           Margin="0,0,20,0"
                                                           VerticalAlignment="Center" />

                                <!-- Selection Switch -->
                                <CheckBox Grid.Column="3"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Style="{StaticResource PillToggleSwitchStyle}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="{Binding Name}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty State -->
        <Border Grid.Row="2"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="40"
                Visibility="{Binding HasDevices, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="390">
                <Border Width="72"
                        Height="72"
                        CornerRadius="22"
                        Background="{DynamicResource Brush.Canvas.Subtle}"
                        BorderBrush="{DynamicResource Brush.Border.Hairline}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,18">
                    <Path Data="{StaticResource Icon.Headphones}"
                          Stroke="{DynamicResource Brush.Ink.Muted}"
                          StrokeThickness="1.75"
                          Width="32"
                          Height="32"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Your listening group starts here."
                           FontFamily="{StaticResource Font.Display}"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Ink.Primary}"
                           TextAlignment="Center" />
                <TextBlock Text="Connect headphones to Windows, then find them here."
                           FontSize="14"
                           Foreground="{DynamicResource Brush.Ink.Secondary}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,8,0,22" />
                <Button Content="Add headphones"
                        Style="{StaticResource PrimaryPillButtonStyle}"
                        Command="{Binding AddHeadphonesCommand}"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
