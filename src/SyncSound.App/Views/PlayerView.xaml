<UserControl x:Class="SyncSound.App.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             DragOver="PlayerView_DragOver"
             Drop="PlayerView_Drop">
    <Grid Margin="40,32,40,32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="0.9*" />
        </Grid.ColumnDefinitions>

        <!-- Left: Now Playing Stage -->
        <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Album Artwork -->
                <Grid Grid.Row="0"
                      Width="216"
                      Height="216"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0,0,0,20">
                    <Border CornerRadius="22"
                            Background="{StaticResource Brush.Canvas.Primary}"
                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.14" Color="#18181B" />
                        </Border.Effect>
                        <Grid>
                            <!-- Fallback Minimal Vinyl/Wave Art -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasAlbumArt, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Ellipse Width="76" Height="76" Fill="{StaticResource Brush.Accent.Soft}" Stroke="{StaticResource Brush.Accent.Border}" StrokeThickness="1.5" />
                                <Path Data="{StaticResource Icon.Player}"
                                      Stroke="{StaticResource Brush.Accent.Primary}"
                                      StrokeThickness="1.8"
                                      Width="32"
                                      Height="32"
                                      Margin="0,-54,0,0"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Real Album Artwork -->
                            <Border CornerRadius="22"
                                    ClipToBounds="True"
                                    Visibility="{Binding HasAlbumArt, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Image Source="{Binding AlbumArtBytes, Converter={StaticResource ByteArrayToImageSourceConverter}}"
                                       Stretch="UniformToFill" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Track Metadata & Output Badge -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <TextBlock Text="{Binding TrackTitle}"
                               FontFamily="{StaticResource Font.Display}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Ink.Primary}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="380" />
                    <TextBlock Text="{Binding TrackArtist}"
                               FontSize="13.5"
                               Foreground="{StaticResource Brush.Ink.Secondary}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="380"
                               Margin="0,4,0,12" />

                    <Border Background="{StaticResource Brush.Accent.Soft}"
                            CornerRadius="12"
                            Padding="12,5"
                            HorizontalAlignment="Center">
                        <TextBlock Text="{Binding OutputBadge}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Accent.Primary}" />
                    </Border>

                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="12.5"
                               Foreground="{StaticResource Brush.Status.Error}"
                               TextAlignment="Center"
                               Margin="0,8,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <!-- Seek Bar -->
                <Grid Grid.Row="2" Margin="0,0,0,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Slider Grid.Row="0"
                            Style="{StaticResource MinimalSliderStyle}"
                            Minimum="0"
                            Maximum="{Binding DurationSeconds}"
                            Value="{Binding PositionSeconds, Mode=TwoWay}"
                            IsEnabled="{Binding HasTrack}"
                            PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseDown"
                            PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseUp" />

                    <DockPanel Grid.Row="1" Margin="2,4,2,0">
                        <TextBlock Text="{Binding ElapsedText}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource Brush.Ink.Muted}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding DurationText}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource Brush.Ink.Muted}"
                                   HorizontalAlignment="Right" />
                    </DockPanel>
                </Grid>

                <!-- Transport Controls -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,18">
                    <Button Style="{StaticResource RoundTransportButtonStyle}"
                            Command="{Binding PreviousCommand}"
                            ToolTip="Previous"
                            Margin="0,0,14,0">
                        <Path Data="{StaticResource Icon.Previous}"
                              Fill="{StaticResource Brush.Ink.Primary}"
                              Width="14"
                              Height="14"
                              Stretch="Uniform" />
                    </Button>

                    <Button Width="56"
                            Height="56"
                            Command="{Binding PlayPauseCommand}"
                            ToolTip="Play or Pause"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Circle"
                                        CornerRadius="28"
                                        Background="{StaticResource Brush.Accent.Primary}"
                                        Effect="{StaticResource Shadow.HeroButton}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Circle" Property="Background" Value="{StaticResource Brush.Accent.Hover}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Circle" Property="Opacity" Value="0.45" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <Path Data="{StaticResource Icon.Play}"
                                  Fill="#FFFFFF"
                                  Width="18"
                                  Height="18"
                                  Margin="2,0,0,0"
                                  Stretch="Uniform"
                                  Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            <Path Data="{StaticResource Icon.Pause}"
                                  Fill="#FFFFFF"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource RoundTransportButtonStyle}"
                            Command="{Binding NextCommand}"
                            ToolTip="Next"
                            Margin="14,0,0,0">
                        <Path Data="{StaticResource Icon.Next}"
                              Fill="{StaticResource Brush.Ink.Primary}"
                              Width="14"
                              Height="14"
                              Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <!-- Volume Bar -->
                <Grid Grid.Row="4" MaxWidth="260" HorizontalAlignment="Center" Width="260">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Volume"
                               FontSize="12"
                               Foreground="{StaticResource Brush.Ink.Muted}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Slider Grid.Column="1"
                            Style="{StaticResource MinimalSliderStyle}"
                            Minimum="0"
                            Maximum="1"
                            Value="{Binding Volume, Mode=TwoWay}" />
                </Grid>
            </Grid>
        </Border>

        <!-- Right: Queue & Import -->
        <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}" Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Up next"
                               FontFamily="{StaticResource Font.Display}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Ink.Primary}"
                               VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right"
                            Content="Import song"
                            Style="{StaticResource PrimaryPillButtonStyle}"
                            Padding="16,8"
                            FontSize="12.5"
                            HorizontalAlignment="Right"
                            Command="{Binding ImportFilesCommand}" />
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Queue}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12"
                                        Background="{StaticResource Brush.Canvas.Primary}"
                                        Padding="12,10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Command="{Binding DataContext.PlayQueueItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalContentAlignment="Left"
                                                Cursor="Hand">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.Ink.Primary}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Artist}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource Brush.Ink.Secondary}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DurationText}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource Brush.Ink.Muted}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0" />

                                        <Button Grid.Column="2"
                                                Content="×"
                                                Command="{Binding DataContext.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="15"
                                                Foreground="{StaticResource Brush.Ink.Muted}"
                                                Cursor="Hand"
                                                Padding="4,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="1"
                           Text="Drag and drop MP3, WAV, FLAC, or M4A files anywhere here to test multi-headphone music playback."
                           FontSize="13"
                           Foreground="{StaticResource Brush.Ink.Muted}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="12"
                           Visibility="{Binding HasQueue, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                <Button Grid.Row="2"
                        Content="Clear queue"
                        Style="{StaticResource SecondaryPillButtonStyle}"
                        Command="{Binding ClearQueueCommand}"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
