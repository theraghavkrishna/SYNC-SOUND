<UserControl x:Class="SyncSound.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="44,36,44,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Centered Editorial Hero -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="600">

            <!-- Acoustic Emblem -->
            <Grid Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,28">
                <Ellipse x:Name="PulseRing"
                         Width="96"
                         Height="96"
                         Fill="{StaticResource Brush.Accent.Soft}"
                         Stroke="{StaticResource Brush.Accent.Border}"
                         StrokeThickness="1.5" />
                <Ellipse Width="70"
                         Height="70"
                         Fill="{StaticResource Brush.Surface.Card}">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.08" Color="#18181B" />
                    </Ellipse.Effect>
                </Ellipse>

                <!-- 4-bar SYNC SOUND acoustic wave mark -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="4.5" Height="14" CornerRadius="2.25" Background="{StaticResource Brush.Accent.Primary}" Margin="2.5,0" />
                    <Border Width="4.5" Height="26" CornerRadius="2.25" Background="{StaticResource Brush.Accent.Primary}" Margin="2.5,0" />
                    <Border Width="4.5" Height="20" CornerRadius="2.25" Background="{StaticResource Brush.Ink.Primary}" Margin="2.5,0" />
                    <Border Width="4.5" Height="12" CornerRadius="2.25" Background="{StaticResource Brush.Accent.Primary}" Margin="2.5,0" />
                </StackPanel>
            </Grid>

            <!-- Hero Headline -->
            <TextBlock Text="{Binding HeroTitle}"
                       FontFamily="{StaticResource Font.Display}"
                       FontSize="36"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Ink.Primary}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <!-- Hero Subheadline -->
            <TextBlock Text="{Binding HeroSubtitle}"
                       FontSize="15.5"
                       Foreground="{StaticResource Brush.Ink.Secondary}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       LineHeight="24"
                       Margin="0,12,0,0" />

            <!-- Live Selected / Connected Device Chips -->
            <ItemsControl ItemsSource="{Binding HomeDeviceChips}"
                          Margin="0,24,0,0"
                          HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Brush.Surface.Card}"
                                BorderBrush="{StaticResource Brush.Border.Hairline}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="14,7"
                                Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Status.Success}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource Brush.Ink.Primary}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Inline Error / Partial Notice -->
            <Border Background="{StaticResource Brush.Status.WarningSoft}"
                    BorderBrush="#FCD34D"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,10"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    Visibility="{Binding HasErrorBanner, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusBannerMessage}"
                           FontSize="13"
                           Foreground="{StaticResource Brush.Status.Warning}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </Border>

            <!-- Primary & Secondary Actions -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,28,0,0">
                <Button Content="{Binding ShareButtonText}"
                        Style="{StaticResource PrimaryPillButtonStyle}"
                        Command="{Binding ToggleSharingCommand}"
                        MinWidth="180"
                        Margin="0,0,12,0" />

                <Button Content="Choose headphones"
                        Style="{StaticResource SecondaryPillButtonStyle}"
                        Command="{Binding ManageDevicesCommand}"
                        Padding="22,13" />
            </StackPanel>
        </StackPanel>

        <!-- Bottom Subtle Tip -->
        <Border Grid.Row="1"
                HorizontalAlignment="Center"
                Background="{StaticResource Brush.Canvas.Subtle}"
                CornerRadius="14"
                Padding="16,9">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Quick Sidebar available anytime with"
                           FontSize="12.5"
                           Foreground="{StaticResource Brush.Ink.Muted}"
                           VerticalAlignment="Center" />
                <Border Background="{StaticResource Brush.Surface.Card}"
                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="7,2"
                        Margin="8,0">
                    <TextBlock Text="{Binding ShortcutHint}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Ink.Primary}" />
                </Border>
                <Button Content="Preview now"
                        Command="{Binding OpenSidebarCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource Brush.Accent.Primary}"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Padding="4,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
