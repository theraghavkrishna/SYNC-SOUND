<UserControl x:Class="SyncSound.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SyncSound.App.Controls">
    <Grid Margin="38,44,38,28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="26" />
            <ColumnDefinition Width="0.95*" MinWidth="320" MaxWidth="400" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: Listening Hero Stage -->
        <DockPanel Grid.Column="0">
            <!-- Bottom Quick Sidebar Tip -->
            <Border DockPanel.Dock="Bottom"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource Brush.Surface.ElevatedCard}"
                    BorderBrush="{DynamicResource Brush.Border.Hairline}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,8"
                    Effect="{DynamicResource Shadow.SoftCard}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Quick Sidebar"
                               FontSize="12.5"
                               Foreground="{DynamicResource Brush.Ink.Secondary}"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource Brush.Surface.SignatureCard}"
                            CornerRadius="6"
                            Padding="8,3"
                            Margin="8,0">
                        <TextBlock Text="{Binding ShortcutHint}"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#F4EFE6" />
                    </Border>
                    <Button Content="Open now"
                            Command="{Binding OpenSidebarCommand}"
                            Style="{StaticResource QuietButtonStyle}"
                            Foreground="{DynamicResource Brush.Accent.Primary}"
                            FontSize="12.5"
                            Padding="6,2" />
                </StackPanel>
            </Border>

            <!-- Hero Content -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="520">
                <!-- Session Meta Pills -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                    <Border Background="{DynamicResource Brush.Surface.ElevatedCard}"
                            BorderBrush="{DynamicResource Brush.Border.Hairline}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12,5"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Ink.Muted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasConnectedDevices}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Status.Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSharing}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Accent.Primary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectedCountText}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Ink.Primary}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource Brush.Accent.Soft}"
                            BorderBrush="{DynamicResource Brush.Accent.Border}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12,5">
                        <TextBlock Text="{Binding SelectedCountText}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Accent.Primary}" />
                    </Border>
                </StackPanel>

                <!-- Signature State-Driven Sync Orb -->
                <controls:SyncOrb VisualState="{Binding VisualState}"
                                  HorizontalAlignment="Left"
                                  Margin="-8,0,0,18" />

                <!-- Editorial Display Headline -->
                <TextBlock Text="{Binding HeroTitle}"
                           FontFamily="{StaticResource Font.Display}"
                           FontSize="40"
                           FontWeight="Bold"
                           LineHeight="46"
                           Foreground="{DynamicResource Brush.Ink.Primary}"
                           TextWrapping="Wrap" />

                <!-- Editorial Italic Serif Accent -->
                <TextBlock Text="{Binding HeroAccent}"
                           FontFamily="{StaticResource Font.Editorial}"
                           FontStyle="Italic"
                           FontSize="21"
                           Foreground="{DynamicResource Brush.Accent.Primary}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />

                <!-- Supporting Copy -->
                <TextBlock Text="{Binding HeroSubtitle}"
                           FontSize="14.5"
                           Foreground="{DynamicResource Brush.Ink.Secondary}"
                           TextWrapping="Wrap"
                           LineHeight="22"
                           Margin="0,12,0,0" />

                <!-- Inline Status / Warning Banner -->
                <Border Background="{DynamicResource Brush.Status.WarningSoft}"
                        BorderBrush="{DynamicResource Brush.Accent.Border}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,9"
                        Margin="0,14,0,0"
                        Visibility="{Binding HasErrorBanner, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding StatusBannerMessage}"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource Brush.Status.Warning}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Primary & Secondary Actions -->
                <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                    <Button Content="{Binding ShareButtonText}"
                            Style="{StaticResource PrimaryPillButtonStyle}"
                            Command="{Binding ToggleSharingCommand}"
                            MinWidth="178"
                            Margin="0,0,12,0" />

                    <Button Content="Headphones"
                            Style="{StaticResource SecondaryPillButtonStyle}"
                            Command="{Binding ManageDevicesCommand}"
                            Padding="20,13" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- RIGHT: Master Sync Dial + Listening Group -->
        <Grid Grid.Column="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Master Volume Sync Dial Card -->
            <Border Grid.Row="0" Style="{StaticResource SurfaceCardStyle}" Padding="20,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:SyncDial Grid.Column="0"
                                       Value="{Binding MasterVolume, Mode=TwoWay}"
                                       IsMuted="{Binding IsMuted}"
                                       MuteToggled="OnDialMuteToggled" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Listening volume"
                                   FontFamily="{StaticResource Font.Display}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Ink.Primary}" />
                        <TextBlock Text="Controls your shared SYNC SOUND session level."
                                   FontSize="12.5"
                                   Foreground="{DynamicResource Brush.Ink.Secondary}"
                                   TextWrapping="Wrap"
                                   LineHeight="18"
                                   Margin="0,4,0,12" />
                        <Button Command="{Binding ToggleMuteCommand}"
                                Style="{StaticResource SecondaryPillButtonStyle}"
                                HorizontalAlignment="Left"
                                Padding="14,7"
                                FontSize="12.5">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14" Height="14" Stretch="Uniform"
                                      Stroke="{DynamicResource Brush.Ink.Primary}"
                                      StrokeThickness="1.75"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Margin="0,0,7,0">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="{StaticResource Icon.Volume}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                    <Setter Property="Data" Value="{StaticResource Icon.Mute}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Mute" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                    <Setter Property="Text" Value="Unmute" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Listening Group Card -->
            <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}" Padding="20,18">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Listening group"
                                   FontFamily="{StaticResource Font.Display}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Ink.Primary}" />
                        <Button DockPanel.Dock="Right"
                                Content="Manage"
                                Command="{Binding ManageDevicesCommand}"
                                Style="{StaticResource QuietButtonStyle}"
                                Foreground="{DynamicResource Brush.Accent.Primary}"
                                HorizontalAlignment="Right"
                                FontSize="12.5"
                                Padding="8,2" />
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ListeningGroupDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Brush.Canvas.Subtle}"
                                            CornerRadius="14"
                                            Padding="12,10"
                                            Margin="0,0,0,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Border}" />
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="36" Height="36" CornerRadius="10"
                                                    Background="{DynamicResource Brush.Surface.ElevatedCard}"
                                                    BorderBrush="{DynamicResource Brush.Border.Hairline}"
                                                    BorderThickness="1"
                                                    Margin="0,0,10,0">
                                                <Path Data="{Binding DeviceIconGeometry}"
                                                      StrokeThickness="1.75"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Width="17" Height="17" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Stroke" Value="{DynamicResource Brush.Ink.Secondary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Stroke" Value="{DynamicResource Brush.Accent.Primary}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Ink.Primary}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding CategoryLabel}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource Brush.Ink.Secondary}" />
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text=" · " FontSize="12" Foreground="{DynamicResource Brush.Ink.Muted}" />
                                                        <TextBlock Text="{Binding BatteryText}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Brush.Status.Success}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <CheckBox Grid.Column="2"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Style="{StaticResource PillToggleSwitchStyle}"
                                                      VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
