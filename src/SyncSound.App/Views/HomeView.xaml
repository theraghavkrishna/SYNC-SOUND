<UserControl x:Class="SyncSound.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="48,38,48,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Centered Motion-Rich Orbital Acoustic Hero -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="640">

            <!-- Editorial Tech Pill Badge (Matches Landing Page) -->
            <Border Background="{StaticResource Brush.Surface.GlassCard}"
                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14,6"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,22"
                    Effect="{StaticResource Shadow.SoftCard}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Brush.Accent.Primary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSharing}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Status.Success}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontFamily="{StaticResource Font.Mono}"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Ink.Secondary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="MULTI-OUTPUT ENGINE · STANDBY" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSharing}" Value="True">
                                        <Setter Property="Text" Value="MULTI-OUTPUT ENGINE · STREAMING LIVE" />
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Ink.Primary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Orbital Spatial Acoustic Stage -->
            <Grid Width="180" Height="180" HorizontalAlignment="Center" Margin="0,0,0,20">
                <!-- Outer Rotating Dashed Orbital Ring -->
                <Ellipse Width="172"
                         Height="172"
                         Stroke="#3CE85D3F"
                         StrokeThickness="1.3"
                         StrokeDashArray="6 8"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="0" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:22" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <!-- Counter-Rotating Inner Segmented Ring -->
                <Ellipse Width="140"
                         Height="140"
                         Stroke="#68E85D3F"
                         StrokeThickness="1.5"
                         StrokeDashArray="18 10 4 10"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="360" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="360" To="0" Duration="0:0:14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <!-- Active Sonar Pulse Wave (triggers when IsSharing == True) -->
                <Ellipse Width="132"
                         Height="132"
                         Stroke="{StaticResource Brush.Accent.Primary}"
                         StrokeThickness="2"
                         Opacity="0"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSharing}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="SonarWave">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 From="0.72" To="1.40" Duration="0:0:1.7" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 From="0.72" To="1.40" Duration="0:0:1.7" />
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.80" To="0.0" Duration="0:0:1.7" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="SonarWave" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <!-- Ambient Breathing Halo -->
                <Ellipse Width="114"
                         Height="114"
                         Fill="{StaticResource Brush.Accent.Soft}"
                         Stroke="{StaticResource Brush.Accent.Border}"
                         StrokeThickness="1.2"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             From="0.95" To="1.05" Duration="0:0:2.4">
                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             From="0.95" To="1.05" Duration="0:0:2.4">
                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <!-- 3D Specular Obsidian Hardware Sphere -->
                <Ellipse Width="90"
                         Height="90"
                         Fill="{StaticResource Brush.Surface.SphereGlass}"
                         Stroke="#40FFFFFF"
                         StrokeThickness="1.2">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="26" ShadowDepth="8" Opacity="0.34" Color="#141417" />
                    </Ellipse.Effect>
                </Ellipse>

                <!-- 7-Bar Reactive Spatial Equalizer (Burnt Orange + Cream inside Obsidian Sphere) -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="3.5" Height="12" CornerRadius="1.75" Background="{StaticResource Brush.Accent.Primary}" Margin="1.8,0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform ScaleY="0.7" /></Border.RenderTransform>
                        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsSharing}" Value="True"><DataTrigger.EnterActions><BeginStoryboard x:Name="B1"><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.4" To="1.5" Duration="0:0:0.41" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions><DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="B1" /></DataTrigger.ExitActions></DataTrigger></Style.Triggers></Style></Border.Style>
                    </Border>
                    <Border Width="3.5" Height="22" CornerRadius="1.75" Background="{StaticResource Brush.Accent.Hover}" Margin="1.8,0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform ScaleY="0.85" /></Border.RenderTransform>
                        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsSharing}" Value="True"><DataTrigger.EnterActions><BeginStoryboard x:Name="B2"><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1.25" To="0.35" Duration="0:0:0.32" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions><DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="B2" /></DataTrigger.ExitActions></DataTrigger></Style.Triggers></Style></Border.Style>
                    </Border>
                    <Border Width="3.5" Height="30" CornerRadius="1.75" Background="#F7F4ED" Margin="1.8,0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform ScaleY="0.9" /></Border.RenderTransform>
                        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsSharing}" Value="True"><DataTrigger.EnterActions><BeginStoryboard x:Name="B3"><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.45" To="1.2" Duration="0:0:0.27" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions><DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="B3" /></DataTrigger.ExitActions></DataTrigger></Style.Triggers></Style></Border.Style>
                    </Border>
                    <Border Width="3.5" Height="36" CornerRadius="1.75" Background="#FFFFFF" Margin="1.8,0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform ScaleY="0.85" /></Border.RenderTransform>
                        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsSharing}" Value="True"><DataTrigger.EnterActions><BeginStoryboard x:Name="B4"><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1.15" To="0.4" Duration="0:0:0.24" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions><DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="B4" /></DataTrigger.ExitActions></DataTrigger></Style.Triggers></Style></Border.Style>
                    </Border>
                    <Border Width="3.5" Height="28" CornerRadius="1.75" Background="#F7F4ED" Margin="1.8,0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform ScaleY="0.9" /></Border.RenderTransform>
                        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsSharing}" Value="True"><DataTrigger.EnterActions><BeginStoryboard x:Name="B5"><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.5" To="1.25" Duration="0:0:0.30" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions><DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="B5" /></DataTrigger.ExitActions></DataTrigger></Style.Triggers></Style></Border.Style>
                    </Border>
                    <Border Width="3.5" Height="20" CornerRadius="1.75" Background="{StaticResource Brush.Accent.Hover}" Margin="1.8,0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform ScaleY="0.8" /></Border.RenderTransform>
                        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsSharing}" Value="True"><DataTrigger.EnterActions><BeginStoryboard x:Name="B6"><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1.3" To="0.4" Duration="0:0:0.36" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions><DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="B6" /></DataTrigger.ExitActions></DataTrigger></Style.Triggers></Style></Border.Style>
                    </Border>
                    <Border Width="3.5" Height="12" CornerRadius="1.75" Background="{StaticResource Brush.Accent.Primary}" Margin="1.8,0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform ScaleY="0.7" /></Border.RenderTransform>
                        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsSharing}" Value="True"><DataTrigger.EnterActions><BeginStoryboard x:Name="B7"><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.45" To="1.45" Duration="0:0:0.44" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions><DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="B7" /></DataTrigger.ExitActions></DataTrigger></Style.Triggers></Style></Border.Style>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Editorial Hero Headline -->
            <TextBlock Text="{Binding HeroTitle}"
                       FontFamily="{StaticResource Font.Display}"
                       FontSize="42"
                       FontWeight="Bold"
                       Foreground="{StaticResource Brush.Ink.Primary}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <!-- Editorial Burnt-Orange Serif Accent -->
            <TextBlock Text="One sound. Everyone listening."
                       FontFamily="{StaticResource Font.Editorial}"
                       FontStyle="Italic"
                       FontSize="20"
                       Foreground="{StaticResource Brush.Accent.Primary}"
                       TextAlignment="Center"
                       Margin="0,4,0,0" />

            <!-- Hero Subheadline -->
            <TextBlock Text="{Binding HeroSubtitle}"
                       FontSize="15"
                       Foreground="{StaticResource Brush.Ink.Secondary}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       LineHeight="23"
                       Margin="0,12,0,0" />

            <!-- Live Selected / Connected Device Chips (Tactile Cream-White Pills) -->
            <ItemsControl ItemsSource="{Binding HomeDeviceChips}"
                          Margin="0,22,0,0"
                          HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Brush.Surface.GlassCard}"
                                BorderBrush="{StaticResource Brush.Border.Hairline}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="14,8"
                                Margin="5"
                                Effect="{StaticResource Shadow.SoftCard}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Status.Success}" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.7" Color="#10B981" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="{Binding}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Ink.Primary}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Inline Error / Partial Notice -->
            <Border Background="{StaticResource Brush.Status.WarningSoft}"
                    BorderBrush="#66D97706"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,10"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    Visibility="{Binding HasErrorBanner, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusBannerMessage}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{StaticResource Brush.Status.Warning}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </Border>

            <!-- Primary & Secondary Tactile Pill Actions -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,28,0,0">
                <Button Content="{Binding ShareButtonText}"
                        Style="{StaticResource PrimaryPillButtonStyle}"
                        Command="{Binding ToggleSharingCommand}"
                        MinWidth="196"
                        Margin="0,0,12,0" />

                <Button Content="Manage outputs"
                        Style="{StaticResource SecondaryPillButtonStyle}"
                        Command="{Binding ManageDevicesCommand}"
                        Padding="22,13" />
            </StackPanel>
        </StackPanel>

        <!-- Bottom Tactile Shortcut Pill -->
        <Border Grid.Row="1"
                HorizontalAlignment="Center"
                Background="{StaticResource Brush.Surface.GlassCard}"
                BorderBrush="{StaticResource Brush.Border.Hairline}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16,9"
                Effect="{StaticResource Shadow.SoftCard}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Summon Quick Sidebar anytime with"
                           FontSize="12.5"
                           Foreground="{StaticResource Brush.Ink.Secondary}"
                           VerticalAlignment="Center" />
                <Border Background="{StaticResource Brush.Surface.InkCard}"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="9,3.5"
                        Margin="9,0">
                    <TextBlock Text="{Binding ShortcutHint}"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#F7F4ED" />
                </Border>
                <Button Content="Open sidebar →"
                        Command="{Binding OpenSidebarCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource Brush.Accent.Primary}"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Padding="4,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
