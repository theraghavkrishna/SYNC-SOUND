<UserControl x:Class="SyncSound.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SyncSound.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="34,42,34,26" VerticalAlignment="Center" MaxWidth="980">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.18*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="0.88*" MinWidth="310" MaxWidth="376" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Studio Listening Stage Card -->
            <Border Grid.Column="0"
                    Style="{StaticResource SurfaceCardStyle}"
                    Padding="28,26"
                    VerticalAlignment="Center">
                <StackPanel>
                    <!-- Status Pills -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Background="{DynamicResource Brush.Canvas.Subtle}"
                                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="11,5"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Ink.Muted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasConnectedDevices}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Status.Success}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSharing}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Accent.Primary}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ConnectedCountText}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Ink.Primary}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource Brush.Accent.Soft}"
                                BorderBrush="{DynamicResource Brush.Accent.Border}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="11,5">
                            <TextBlock Text="{Binding SelectedCountText}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Accent.Primary}" />
                        </Border>
                    </StackPanel>

                    <!-- Signature Stateful Sync Orb -->
                    <controls:SyncOrb VisualState="{Binding VisualState}"
                                      HorizontalAlignment="Left"
                                      Margin="-6,0,0,14" />

                    <!-- Editorial Headline + Italic Accent -->
                    <TextBlock Text="{Binding HeroTitle}"
                               FontFamily="{StaticResource Font.Display}"
                               FontSize="36"
                               FontWeight="Bold"
                               LineHeight="42"
                               Foreground="{DynamicResource Brush.Ink.Primary}"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{Binding HeroAccent}"
                               FontFamily="{StaticResource Font.Editorial}"
                               FontStyle="Italic"
                               FontSize="19"
                               Foreground="{DynamicResource Brush.Accent.Primary}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0" />

                    <TextBlock Text="{Binding HeroSubtitle}"
                               FontSize="14.5"
                               Foreground="{DynamicResource Brush.Ink.Secondary}"
                               TextWrapping="Wrap"
                               LineHeight="21"
                               Margin="0,10,0,0" />

                    <!-- Optional Alert Banner -->
                    <Border Background="{DynamicResource Brush.Status.WarningSoft}"
                            BorderBrush="{DynamicResource Brush.Accent.Border}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,8"
                            Margin="0,14,0,0"
                            Visibility="{Binding HasErrorBanner, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding StatusBannerMessage}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource Brush.Status.Warning}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Primary & Secondary Actions -->
                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button Content="{Binding ShareButtonText}"
                                Style="{StaticResource PrimaryPillButtonStyle}"
                                Command="{Binding ToggleSharingCommand}"
                                MinWidth="172"
                                Margin="0,0,10,0" />

                        <Button Content="Headphones"
                                Style="{StaticResource SecondaryPillButtonStyle}"
                                Command="{Binding ManageDevicesCommand}"
                                Padding="18,12" />
                    </StackPanel>

                    <!-- Subtle Divider & Quick Sidebar Access -->
                    <Border Height="1" Background="{DynamicResource Brush.Border.Hairline}" Margin="0,22,0,14" />

                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Quick Sidebar"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource Brush.Ink.Secondary}"
                                       VerticalAlignment="Center" />
                            <Border Background="{DynamicResource Brush.Surface.SignatureCard}"
                                    CornerRadius="6"
                                    Padding="8,3"
                                    Margin="8,0">
                                <TextBlock Text="{Binding ShortcutHint}"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#F4EFE6" />
                            </Border>
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Open sidebar"
                                Command="{Binding OpenSidebarCommand}"
                                Style="{StaticResource QuietButtonStyle}"
                                Foreground="{DynamicResource Brush.Accent.Primary}"
                                HorizontalAlignment="Right"
                                FontSize="12.5"
                                Padding="8,4" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- RIGHT: Sync Dial + Compact Listening Group -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <!-- Master Volume Sync Dial Card -->
                <Border Style="{StaticResource SurfaceCardStyle}" Padding="18,16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <controls:SyncDial Grid.Column="0"
                                           Value="{Binding MasterVolume, Mode=TwoWay}"
                                           IsMuted="{Binding IsMuted}"
                                           MuteToggled="OnDialMuteToggled" />

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Listening volume"
                                       FontFamily="{StaticResource Font.Display}"
                                       FontSize="16.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Ink.Primary}" />
                            <TextBlock Text="Adjusts your shared SYNC SOUND session."
                                       FontSize="12.5"
                                       Foreground="{DynamicResource Brush.Ink.Secondary}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,3,0,12" />
                            <Button Command="{Binding ToggleMuteCommand}"
                                    Style="{StaticResource SecondaryPillButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="13,7"
                                    FontSize="12.5">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Stretch="Uniform"
                                          Stroke="{DynamicResource Brush.Ink.Primary}"
                                          StrokeThickness="1.75"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Margin="0,0,6,0">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{StaticResource Icon.Volume}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource Icon.Mute}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Mute" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                        <Setter Property="Text" Value="Unmute" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Compact Listening Group Card -->
                <Border Style="{StaticResource SurfaceCardStyle}" Padding="18,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Listening group"
                                       FontFamily="{StaticResource Font.Display}"
                                       FontSize="16.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Ink.Primary}" />
                            <Button DockPanel.Dock="Right"
                                    Content="Manage"
                                    Command="{Binding ManageDevicesCommand}"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Foreground="{DynamicResource Brush.Accent.Primary}"
                                    HorizontalAlignment="Right"
                                    FontSize="12.5"
                                    Padding="8,2" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding ListeningGroupDevices}" MaxHeight="240">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding ToggleCommand}"
                                            ToolTip="{Binding FullSystemName}"
                                            Cursor="Hand"
                                            Margin="0,0,0,8">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Card"
                                                        Background="{DynamicResource Brush.Canvas.Subtle}"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="1.2"
                                                        CornerRadius="14"
                                                        Padding="12,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Width="34" Height="34" CornerRadius="10"
                                                                Background="{DynamicResource Brush.Surface.ElevatedCard}"
                                                                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                                                                BorderThickness="1"
                                                                Margin="0,0,10,0">
                                                            <Path Data="{Binding DeviceIconGeometry}"
                                                                  StrokeThickness="1.75"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  Width="16" Height="16" Stretch="Uniform"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Stroke" Value="{DynamicResource Brush.Ink.Secondary}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Stroke" Value="{DynamicResource Brush.Accent.Primary}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="13.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Brush.Ink.Primary}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding CategoryLabel}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource Brush.Ink.Secondary}" />
                                                                <StackPanel Orientation="Horizontal"
                                                                            Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <TextBlock Text=" · " FontSize="12" Foreground="{DynamicResource Brush.Ink.Muted}" />
                                                                    <TextBlock Text="{Binding BatteryText}"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource Brush.Status.Success}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Tactile Join/Selected Checkmark Pill -->
                                                        <Border Grid.Column="2"
                                                                Width="26" Height="26"
                                                                CornerRadius="13"
                                                                VerticalAlignment="Center"
                                                                BorderThickness="1.2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Hairline}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Path Data="{StaticResource Icon.Check}"
                                                                  Stroke="#FCFBF8"
                                                                  StrokeThickness="2"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  Width="12" Height="12" Stretch="Uniform"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Border}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty Devices Inline Hint -->
                        <TextBlock Text="Connect headphones in Windows to add them here."
                                   FontSize="12.5"
                                   Foreground="{DynamicResource Brush.Ink.Muted}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding HasConnectedDevices, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
