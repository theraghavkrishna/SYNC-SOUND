<Window x:Class="SyncSound.App.Views.QuickSidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SyncSound.App.Controls"
        Title="SYNC SOUND Quick Sidebar"
        Width="388"
        Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <Border Margin="14"
            Background="{StaticResource Brush.Canvas.Primary}"
            BorderBrush="{StaticResource Brush.Border.GlassRim}"
            BorderThickness="1.2"
            CornerRadius="24"
            Effect="{StaticResource Shadow.Sidebar}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="0" />
        </Border.RenderTransform>

        <Grid>
            <!-- Subtle Top Ambient Glow -->
            <Rectangle Fill="{StaticResource Brush.Canvas.AmbientGlow}" RadiusX="24" RadiusY="24" IsHitTestVisible="False" />

            <Grid Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Wordmark + Close -->
                <DockPanel Grid.Row="0" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,9,0" VerticalAlignment="Center">
                            <Border Width="3" Height="10" CornerRadius="1.5" Background="{StaticResource Brush.Accent.Primary}" Margin="1.5,0" />
                            <Border Width="3" Height="17" CornerRadius="1.5" Background="{StaticResource Brush.Accent.Primary}" Margin="1.5,0" />
                            <Border Width="3" Height="12" CornerRadius="1.5" Background="{StaticResource Brush.Ink.Primary}" Margin="1.5,0" />
                        </StackPanel>
                        <TextBlock Text="SYNC SOUND"
                                   FontFamily="{StaticResource Font.Display}"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Ink.Primary}" />
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Content="×"
                            Command="{Binding CloseSidebarCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="20"
                            Foreground="{StaticResource Brush.Ink.Muted}"
                            Cursor="Hand"
                            HorizontalAlignment="Right"
                            Padding="6,0" />
                </DockPanel>

                <!-- Status Hero Card -->
                <Border Grid.Row="1"
                        Style="{StaticResource SurfaceCardStyle}"
                        Padding="18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Ink.Muted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSharing}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Brush.Status.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusHeadline}"
                                       FontFamily="{StaticResource Font.Display}"
                                       FontSize="18.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Ink.Primary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusDetail}"
                                   FontSize="12.5"
                                   Foreground="{StaticResource Brush.Ink.Secondary}"
                                   Margin="16,2,0,14" />
                        <Button Content="{Binding ShareButtonText}"
                                Style="{StaticResource PrimaryPillButtonStyle}"
                                Command="{Binding ToggleSharingCommand}"
                                Padding="18,11"
                                FontSize="13.5" />
                    </StackPanel>
                </Border>

                <!-- Quick Device List with Per-Device Volume Knobs -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Brush.Surface.GlassCard}"
                                        CornerRadius="16"
                                        Padding="13,10"
                                        Margin="0,0,0,9">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.GlassRim}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent.Border}" />
                                                    <Setter Property="BorderThickness" Value="1.2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Ink.Primary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CategoryLabel}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource Brush.Ink.Muted}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <controls:RotaryVolumeKnob Grid.Column="1"
                                                                   DialSize="34"
                                                                   Width="42"
                                                                   Height="48"
                                                                   Value="{Binding Volume, Mode=TwoWay}"
                                                                   Margin="0,0,10,0"
                                                                   VerticalAlignment="Center" />

                                        <CheckBox Grid.Column="2"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Style="{StaticResource PillToggleSwitchStyle}"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Open Full App -->
                <Button Grid.Row="3"
                        Content="Open full app"
                        Style="{StaticResource SecondaryPillButtonStyle}"
                        Command="{Binding OpenMainAppCommand}"
                        Margin="0,12,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
