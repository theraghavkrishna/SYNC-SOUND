<Window x:Class="SyncSound.App.Views.QuickSidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SyncSound.App.Controls"
        Title="SYNC SOUND Quick Sidebar"
        Width="360"
        Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <Border Margin="10"
            Background="{DynamicResource Brush.Surface.Glass}"
            BorderBrush="{DynamicResource Brush.Border.Hairline}"
            BorderThickness="1.2"
            CornerRadius="22"
            Effect="{DynamicResource Shadow.Window}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="0" />
        </Border.RenderTransform>

        <Grid>
            <Rectangle Fill="{DynamicResource Brush.Canvas.AmbientGlow}" RadiusX="22" RadiusY="22" IsHitTestVisible="False" />

            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Draggable Header: Vector Lockup + Preferences + Close -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24"
                                Height="24"
                                CornerRadius="7"
                                Background="{DynamicResource Brush.Surface.SignatureCard}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="1.8" Height="5" CornerRadius="0.9" Background="{DynamicResource Brush.Accent.Primary}" Margin="0.8,0" />
                                <Border Width="1.8" Height="10" CornerRadius="0.9" Background="{DynamicResource Brush.Accent.Hover}" Margin="0.8,0" />
                                <Border Width="1.8" Height="14" CornerRadius="0.9" Background="#F4EFE6" Margin="0.8,0" />
                                <Border Width="1.8" Height="10" CornerRadius="0.9" Background="{DynamicResource Brush.Accent.Hover}" Margin="0.8,0" />
                                <Border Width="1.8" Height="5" CornerRadius="0.9" Background="{DynamicResource Brush.Accent.Primary}" Margin="0.8,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="SYNC SOUND"
                                   FontFamily="{StaticResource Font.Display}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Ink.Primary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding OpenPreferencesCommand}"
                                Style="{StaticResource QuietButtonStyle}"
                                ToolTip="Preferences"
                                Padding="6">
                            <Path Data="{StaticResource Icon.Settings}"
                                  Stroke="{DynamicResource Brush.Ink.Secondary}"
                                  StrokeThickness="1.65"
                                  Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <Button Command="{Binding CloseSidebarCommand}"
                                Style="{StaticResource QuietButtonStyle}"
                                ToolTip="Close"
                                Padding="6">
                            <Path Data="{StaticResource Icon.WinClose}"
                                  Stroke="{DynamicResource Brush.Ink.Secondary}"
                                  StrokeThickness="1.6"
                                  Width="11" Height="11" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Signature Contrast Hero Card with Mini Orb -->
                <Border Grid.Row="1"
                        Style="{StaticResource SignatureCardStyle}"
                        Padding="16"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="40" Height="40" CornerRadius="20"
                                    Background="#2A2724"
                                    BorderBrush="{DynamicResource Brush.Accent.Border}"
                                    BorderThickness="1.2"
                                    Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="2.5" Height="8" CornerRadius="1.25" Background="{DynamicResource Brush.Accent.Primary}" Margin="1.2,0" />
                                    <Border Width="2.5" Height="16" CornerRadius="1.25" Background="#F4EFE6" Margin="1.2,0" />
                                    <Border Width="2.5" Height="8" CornerRadius="1.25" Background="{DynamicResource Brush.Accent.Primary}" Margin="1.2,0" />
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusHeadline}"
                                           FontFamily="{StaticResource Font.Display}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#F4EFE6"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StatusDetail}"
                                           FontFamily="{StaticResource Font.Editorial}"
                                           FontStyle="Italic"
                                           FontSize="13"
                                           Foreground="#C65D32" />
                            </StackPanel>
                        </Grid>

                        <Button Content="{Binding ShareButtonText}"
                                Style="{StaticResource PrimaryPillButtonStyle}"
                                Command="{Binding ToggleSharingCommand}"
                                Padding="16,10"
                                FontSize="13.5" />
                    </StackPanel>
                </Border>

                <!-- Master Listening Volume Strip -->
                <Border Grid.Row="2"
                        Style="{StaticResource SurfaceCardStyle}"
                        CornerRadius="14"
                        Padding="12,8"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Command="{Binding ToggleMuteCommand}"
                                Style="{StaticResource QuietButtonStyle}"
                                Padding="5"
                                ToolTip="Mute / Unmute">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.Ink.Primary}"
                                  StrokeThickness="1.75"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource Icon.Volume}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource Icon.Mute}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>

                        <Slider Grid.Column="1"
                                Style="{StaticResource MinimalSliderStyle}"
                                Minimum="0"
                                Maximum="1"
                                Value="{Binding MasterVolume, Mode=TwoWay}"
                                Margin="6,0" />

                        <TextBlock Grid.Column="2"
                                   Text="{Binding MasterVolumePercentText}"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Ink.Primary}"
                                   VerticalAlignment="Center"
                                   MinWidth="36"
                                   TextAlignment="Right" />
                    </Grid>
                </Border>

                <!-- Compact Listening Group -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.Surface.ElevatedCard}"
                                        CornerRadius="14"
                                        Padding="11,9"
                                        Margin="0,0,0,7"
                                        Effect="{DynamicResource Shadow.SoftCard}"
                                        ToolTip="{Binding FullSystemName}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Hairline}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Border}" />
                                                    <Setter Property="BorderThickness" Value="1.3" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Path Grid.Column="0"
                                              Data="{Binding DeviceIconGeometry}"
                                              StrokeThickness="1.75"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="16" Height="16" Stretch="Uniform"
                                              Margin="0,0,9,0"
                                              VerticalAlignment="Center">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Stroke" Value="{DynamicResource Brush.Ink.Secondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Stroke" Value="{DynamicResource Brush.Accent.Primary}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Ink.Primary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                <TextBlock Text="{Binding CategoryLabel}" FontSize="11.5" Foreground="{DynamicResource Brush.Ink.Muted}" />
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text=" · " FontSize="11.5" Foreground="{DynamicResource Brush.Ink.Muted}" />
                                                    <TextBlock Text="{Binding BatteryText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Status.Success}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <CheckBox Grid.Column="2"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Style="{StaticResource PillToggleSwitchStyle}"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Open Full App -->
                <Button Grid.Row="4"
                        Content="Open SYNC SOUND"
                        Style="{StaticResource SecondaryPillButtonStyle}"
                        Command="{Binding OpenMainAppCommand}"
                        Margin="0,8,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
