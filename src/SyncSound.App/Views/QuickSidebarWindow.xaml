<Window x:Class="SyncSound.App.Views.QuickSidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SYNC SOUND Quick Sidebar"
        Width="356"
        Height="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <Border Margin="14"
            Background="{StaticResource Brush.Canvas.Primary}"
            BorderBrush="{StaticResource Brush.Border.Hairline}"
            BorderThickness="1"
            CornerRadius="22"
            Effect="{StaticResource Shadow.Sidebar}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="0" />
        </Border.RenderTransform>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Wordmark + Close -->
            <DockPanel Grid.Row="0" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,9,0" VerticalAlignment="Center">
                        <Border Width="3" Height="10" CornerRadius="1.5" Background="{StaticResource Brush.Accent.Primary}" Margin="1.5,0" />
                        <Border Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource Brush.Accent.Primary}" Margin="1.5,0" />
                        <Border Width="3" Height="12" CornerRadius="1.5" Background="{StaticResource Brush.Ink.Primary}" Margin="1.5,0" />
                    </StackPanel>
                    <TextBlock Text="SYNC SOUND"
                               FontFamily="{StaticResource Font.Display}"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource Brush.Ink.Primary}" />
                </StackPanel>

                <Button DockPanel.Dock="Right"
                        Content="×"
                        Command="{Binding CloseSidebarCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="19"
                        Foreground="{StaticResource Brush.Ink.Muted}"
                        Cursor="Hand"
                        HorizontalAlignment="Right"
                        Padding="6,0" />
            </DockPanel>

            <!-- Status Hero Card -->
            <Border Grid.Row="1"
                    Background="{StaticResource Brush.Surface.Card}"
                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding StatusHeadline}"
                               FontFamily="{StaticResource Font.Display}"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Ink.Primary}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusDetail}"
                               FontSize="12.5"
                               Foreground="{StaticResource Brush.Ink.Secondary}"
                               Margin="0,3,0,14" />
                    <Button Content="{Binding ShareButtonText}"
                            Style="{StaticResource PrimaryPillButtonStyle}"
                            Command="{Binding ToggleSharingCommand}"
                            Padding="18,11"
                            FontSize="13.5" />
                </StackPanel>
            </Border>

            <!-- Quick Device List -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Brush.Surface.Card}"
                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="12,10"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CategoryLabel}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource Brush.Ink.Muted}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Style="{StaticResource PillToggleSwitchStyle}"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Open Full App -->
            <Button Grid.Row="3"
                    Content="Open full app"
                    Style="{StaticResource SecondaryPillButtonStyle}"
                    Command="{Binding OpenMainAppCommand}"
                    Margin="0,12,0,0" />
        </Grid>
    </Border>
</Window>
