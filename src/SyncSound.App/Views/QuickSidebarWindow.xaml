<Window x:Class="SyncSound.App.Views.QuickSidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SyncSound.App.Controls"
        Title="SYNC SOUND Quick Sidebar"
        Width="386"
        Height="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <Grid>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="0" />
        </Grid.RenderTransform>

        <!-- Sibling Window Cast Shadow (No ClearType blur on foreground controls) -->
        <Border Margin="10"
                Background="{DynamicResource Brush.Surface.Glass}"
                CornerRadius="24"
                IsHitTestVisible="False"
                Effect="{DynamicResource Shadow.Window}" />

        <Border Margin="10"
                Background="{DynamicResource Brush.Surface.Glass}"
                BorderBrush="{DynamicResource Brush.Border.GlassRim}"
                BorderThickness="1.2"
                CornerRadius="24"
                ClipToBounds="True">
            <Grid>
                <Rectangle Fill="{DynamicResource Brush.Canvas.AmbientGlow}" IsHitTestVisible="False" />

                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Draggable Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,12" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource Brush.Surface.SignatureCard}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="1.8" Height="5" CornerRadius="0.9" Background="{DynamicResource Brush.Accent.Primary}" Margin="0.8,0" />
                                    <Border Width="1.8" Height="10" CornerRadius="0.9" Background="{DynamicResource Brush.Accent.Hover}" Margin="0.8,0" />
                                    <Border Width="1.8" Height="14" CornerRadius="0.9" Background="#F4EFE6" Margin="0.8,0" />
                                    <Border Width="1.8" Height="10" CornerRadius="0.9" Background="{DynamicResource Brush.Accent.Hover}" Margin="0.8,0" />
                                    <Border Width="1.8" Height="5" CornerRadius="0.9" Background="{DynamicResource Brush.Accent.Primary}" Margin="0.8,0" />
                                </StackPanel>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="SYNC SOUND"
                                           FontFamily="{StaticResource Font.Display}"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Ink.Primary}" />
                                <TextBlock Text="{Binding CountBadgeText}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource Brush.Ink.Muted}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding RefreshCommand}" Style="{StaticResource QuietButtonStyle}" ToolTip="Refresh devices" Padding="6">
                                <Path Data="{StaticResource Icon.Refresh}" Stroke="{DynamicResource Brush.Ink.Secondary}" StrokeThickness="1.65" Width="13" Height="13" Stretch="Uniform" />
                            </Button>
                            <Button Command="{Binding OpenPreferencesCommand}" Style="{StaticResource QuietButtonStyle}" ToolTip="Preferences" Padding="6">
                                <Path Data="{StaticResource Icon.Settings}" Stroke="{DynamicResource Brush.Ink.Secondary}" StrokeThickness="1.65" Width="14" Height="14" Stretch="Uniform" />
                            </Button>
                            <Button Command="{Binding CloseSidebarCommand}" Style="{StaticResource QuietButtonStyle}" ToolTip="Close (Esc)" Padding="6">
                                <Path Data="{StaticResource Icon.WinClose}" Stroke="{DynamicResource Brush.Ink.Secondary}" StrokeThickness="1.6" Width="11" Height="11" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- Signature Hero Card with Real Reactive Mini SyncOrb -->
                    <ContentControl Grid.Row="1" Style="{StaticResource SignatureCardContentStyle}" Padding="16" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <controls:SyncOrb Width="52" Height="52"
                                                  VisualState="{Binding VisualState}"
                                                  AudioLevel="{Binding SignalLevel}"
                                                  SelectedNodeCount="{Binding SelectedCount}"
                                                  ReducedMotion="{Binding ReducedMotion}"
                                                  Margin="0,0,12,0" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusHeadline}"
                                               FontFamily="{StaticResource Font.Display}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#F4EFE6"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding StatusDetail}"
                                               FontFamily="{StaticResource Font.Editorial}"
                                               FontStyle="Italic"
                                               FontSize="13"
                                               Foreground="#C65D32" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="{Binding ShareButtonText}"
                                        Style="{StaticResource PrimaryPillButtonStyle}"
                                        Command="{Binding ToggleSharingCommand}"
                                        Padding="14,10"
                                        FontSize="13.5" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource SecondaryPillButtonStyle}"
                                        Command="{Binding TestSoundCommand}"
                                        ToolTip="Play quick test chime across group"
                                        Padding="12,10">
                                    <Path Data="{StaticResource Icon.TestSignal}"
                                          Stroke="{DynamicResource Brush.Accent.Primary}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="14" Height="14" Stretch="Uniform" />
                                </Button>
                            </Grid>

                            <TextBlock Text="{Binding TestStatusText}"
                                       FontSize="11.5"
                                       Foreground="#D56A3E"
                                       Margin="2,8,0,0"
                                       Visibility="{Binding HasTestStatus, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </ContentControl>

                    <!-- Master Volume Strip -->
                    <ContentControl Grid.Row="2" Style="{StaticResource CardSurfaceStyle}" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Command="{Binding ToggleMuteCommand}" Style="{StaticResource QuietButtonStyle}" Padding="5" ToolTip="Mute / Unmute session">
                                <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource Brush.Ink.Primary}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="{StaticResource Icon.Volume}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                    <Setter Property="Data" Value="{StaticResource Icon.Mute}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource Brush.Accent.Primary}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>

                            <Slider Grid.Column="1" Style="{StaticResource MinimalSliderStyle}" Minimum="0" Maximum="1" Value="{Binding MasterVolume, Mode=TwoWay}" Margin="6,0" />

                            <TextBlock Grid.Column="2" Text="{Binding MasterVolumePercentText}" FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink.Primary}" VerticalAlignment="Center" MinWidth="38" TextAlignment="Right" />
                        </Grid>
                    </ContentControl>

                    <!-- Expandable Device Rows -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="16" Padding="11,9" Margin="0,0,0,7" ToolTip="{Binding FullSystemName}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.ElevatedCard}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Hairline}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Border}" />
                                                        <Setter Property="BorderThickness" Value="1.3" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0" Command="{Binding ToggleExpandCommand}" Cursor="Hand" Margin="0,0,9,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent" Padding="2">
                                                                <Path Data="{Binding DeviceIconGeometry}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path">
                                                                            <Setter Property="Stroke" Value="{DynamicResource Brush.Ink.Secondary}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter Property="Stroke" Value="{DynamicResource Brush.Accent.Primary}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <Button Grid.Column="1" Command="{Binding ToggleExpandCommand}" Cursor="Hand" HorizontalContentAlignment="Left">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <StackPanel VerticalAlignment="Center" Background="Transparent" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink.Primary}" TextTrimming="CharacterEllipsis" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                                    <TextBlock Text="{Binding CategoryLabel}" FontSize="11" Foreground="{DynamicResource Brush.Ink.Secondary}" />
                                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource Brush.Ink.Muted}" />
                                                                        <TextBlock Text="{Binding BatteryText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Status.Success}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <Button Grid.Column="2" Command="{Binding ToggleCommand}" Style="{StaticResource QuietButtonStyle}" Padding="10,4" VerticalAlignment="Center">
                                                    <TextBlock FontSize="11.5" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Join" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Secondary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Text" Value="In group" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                            </Grid>

                                            <!-- Inline Expanded Controls (Volume, Mute, Windows Handoff) -->
                                            <StackPanel Margin="0,9,0,2" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Command="{Binding ToggleMuteCommand}" Style="{StaticResource QuietButtonStyle}" Padding="4" ToolTip="Mute device">
                                                        <Path Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource Brush.Ink.Secondary}" StrokeThickness="1.7">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Data" Value="{StaticResource Icon.Volume}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDeviceMuted}" Value="True">
                                                                            <Setter Property="Data" Value="{StaticResource Icon.Mute}" />
                                                                            <Setter Property="Stroke" Value="{DynamicResource Brush.Accent.Primary}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Button>
                                                    <Slider Grid.Column="1" Style="{StaticResource MinimalSliderStyle}" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" Margin="6,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding VolumePercentText}" FontFamily="{StaticResource Font.Mono}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Footer Actions Bar -->
                    <Border Grid.Row="4" BorderBrush="{DynamicResource Brush.Border.Hairline}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,6,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Left"
                                    Content="Add headphones"
                                    Command="{Binding AddHeadphonesCommand}"
                                    Style="{StaticResource QuietButtonStyle}"
                                    FontSize="12"
                                    Padding="8,4" />
                            <Button DockPanel.Dock="Right"
                                    Content="Open full app"
                                    Command="{Binding OpenMainAppCommand}"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Foreground="{DynamicResource Brush.Accent.Primary}"
                                    HorizontalAlignment="Right"
                                    FontSize="12"
                                    Padding="8,4" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
