<Window x:Class="SyncSound.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:SyncSound.App.Views"
        xmlns:vm="clr-namespace:SyncSound.App.ViewModels"
        Title="SYNC SOUND"
        Icon="Assets/SyncSound.ico"
        Width="1100"
        Height="740"
        MinWidth="880"
        MinHeight="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            CornerRadius="20"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
            <views:DevicesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Ink.Secondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1AFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Ink.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            CornerRadius="20"
            Background="{StaticResource Brush.Canvas.Primary}"
            BorderBrush="{StaticResource Brush.Border.GlassRim}"
            BorderThickness="1.2"
            ClipToBounds="True"
            Effect="{StaticResource Shadow.Sidebar}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Rail (Layered Obsidian Glass) -->
            <Border Grid.Column="0"
                    Background="{StaticResource Brush.Surface.RailGlass}"
                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                    BorderThickness="0,0,1,0"
                    Padding="20,26,20,22">
                <DockPanel>
                    <!-- Brand Header with Animated Equalizer Mark -->
                    <StackPanel DockPanel.Dock="Top" Margin="6,6,0,30">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,11,0" VerticalAlignment="Center">
                                <Border Width="3.5" Height="12" CornerRadius="1.75" Background="{StaticResource Brush.Accent.Primary}" Margin="1.5,0" />
                                <Border Width="3.5" Height="21" CornerRadius="1.75" Background="{StaticResource Brush.Accent.Primary}" Margin="1.5,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.85" Color="#22D3EE" />
                                    </Border.Effect>
                                </Border>
                                <Border Width="3.5" Height="15" CornerRadius="1.75" Background="{StaticResource Brush.Ink.Primary}" Margin="1.5,0" />
                            </StackPanel>
                            <TextBlock Text="SYNC SOUND"
                                       FontFamily="{StaticResource Font.Display}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Ink.Primary}" />
                        </StackPanel>
                        <TextBlock Text="One sound. Everyone listening."
                                   FontSize="11.5"
                                   Foreground="{StaticResource Brush.Ink.Muted}"
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Footer Connection Summary -->
                    <Border DockPanel.Dock="Bottom"
                            Background="{StaticResource Brush.Surface.GlassCard}"
                            BorderBrush="{StaticResource Brush.Border.GlassRim}"
                            BorderThickness="1"
                            CornerRadius="15"
                            Padding="14,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Status.Success}" VerticalAlignment="Center" Margin="0,0,9,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.8" Color="#34D399" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="{Binding FooterConnectionText}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Ink.Primary}" />
                            </StackPanel>
                            <TextBlock Text="Running in background"
                                       FontSize="11.5"
                                       Foreground="{StaticResource Brush.Ink.Muted}"
                                       Margin="17,3,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Navigation Links (3 Core Screens) -->
                    <StackPanel Margin="0,4,0,0">
                        <RadioButton Style="{StaticResource RailNavRadioStyle}"
                                     GroupName="MainNav"
                                     IsChecked="{Binding IsHomeSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Home}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.75"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      Margin="0,0,12,0" />
                                <TextBlock Text="Home" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource RailNavRadioStyle}"
                                     GroupName="MainNav"
                                     IsChecked="{Binding IsDevicesSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Headphones}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.75"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      Margin="0,0,12,0" />
                                <TextBlock Text="Devices" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource RailNavRadioStyle}"
                                     GroupName="MainNav"
                                     IsChecked="{Binding IsSettingsSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Settings}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.65"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      Margin="0,0,12,0" />
                                <TextBlock Text="Settings" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Active View Host with Custom Caption Bar + Ambient Atmospheric Glow -->
            <Grid Grid.Column="1" Background="{StaticResource Brush.Canvas.Primary}">
                <Rectangle Fill="{StaticResource Brush.Canvas.AmbientGlow}" IsHitTestVisible="False" />

                <!-- Custom Dark Window Controls -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,12,14,0"
                            Panel.ZIndex="10">
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            Content="─"
                            ToolTip="Minimize"
                            Click="OnMinimizeClick" />
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            Content="□"
                            ToolTip="Maximize / Restore"
                            Click="OnMaximizeClick"
                            Margin="2,0" />
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            Content="✕"
                            ToolTip="Close"
                            Click="OnCloseClick" />
                </StackPanel>

                <views:HomeView Visibility="{Binding IsHomeSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                <views:DevicesView DataContext="{Binding DevicesViewModel}"
                                   Visibility="{Binding DataContext.IsDevicesSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}" />
                <views:SettingsView DataContext="{Binding SettingsViewModel}"
                                    Visibility="{Binding DataContext.IsSettingsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Grid>
    </Border>
</Window>
