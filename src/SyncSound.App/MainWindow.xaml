<Window x:Class="SyncSound.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:SyncSound.App.Views"
        xmlns:vm="clr-namespace:SyncSound.App.ViewModels"
        Title="SYNC SOUND"
        Icon="Assets/SyncSound.ico"
        Width="1120"
        Height="750"
        MinWidth="900"
        MinHeight="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            CornerRadius="22"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
            <views:DevicesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Ink.Secondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#16141417" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Ink.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFE85D3F" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            CornerRadius="22"
            Background="{StaticResource Brush.Canvas.Primary}"
            BorderBrush="{StaticResource Brush.Border.Hairline}"
            BorderThickness="1.2"
            ClipToBounds="True"
            Effect="{StaticResource Shadow.Sidebar}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Rail (Warm Linen Tactile Surface) -->
            <Border Grid.Column="0"
                    Background="{StaticResource Brush.Surface.RailGlass}"
                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                    BorderThickness="0,0,1,0"
                    Padding="20,26,20,22">
                <DockPanel>
                    <!-- Brand Header with Crisp 8K Vector Squircle Logo -->
                    <StackPanel DockPanel.Dock="Top" Margin="4,4,0,30">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Pure Vector Squircle Badge (Crisp at any DPI) -->
                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="10"
                                    Background="{StaticResource Brush.Surface.InkCard}"
                                    BorderBrush="#33FFFFFF"
                                    BorderThickness="1"
                                    Margin="0,0,12,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.22" Color="#141417" />
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="2.5" Height="8" CornerRadius="1.25" Background="{StaticResource Brush.Accent.Primary}" Margin="1.1,0" />
                                    <Border Width="2.5" Height="14" CornerRadius="1.25" Background="{StaticResource Brush.Accent.Hover}" Margin="1.1,0" />
                                    <Border Width="2.5" Height="19" CornerRadius="1.25" Background="#FFFFFF" Margin="1.1,0" />
                                    <Border Width="2.5" Height="14" CornerRadius="1.25" Background="{StaticResource Brush.Accent.Hover}" Margin="1.1,0" />
                                    <Border Width="2.5" Height="8" CornerRadius="1.25" Background="{StaticResource Brush.Accent.Primary}" Margin="1.1,0" />
                                </StackPanel>
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SYNC SOUND"
                                           FontFamily="{StaticResource Font.Display}"
                                           FontSize="15.5"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Brush.Ink.Primary}" />
                                <TextBlock Text="SHARED AUDIO"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Accent.Primary}"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Footer Connection Summary (Tactile Cream-White Card) -->
                    <Border DockPanel.Dock="Bottom"
                            Style="{StaticResource SurfaceCardStyle}"
                            CornerRadius="16"
                            Padding="14,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Status.Success}" VerticalAlignment="Center" Margin="0,0,9,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.7" Color="#10B981" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="{Binding FooterConnectionText}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Ink.Primary}" />
                            </StackPanel>
                            <TextBlock Text="Tray &amp; shortcut active"
                                       FontSize="11.5"
                                       Foreground="{StaticResource Brush.Ink.Muted}"
                                       Margin="17,3,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Navigation Links (3 Core Screens) -->
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="WORKSPACE"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Ink.Muted}"
                                   Margin="12,0,0,8" />

                        <RadioButton Style="{StaticResource RailNavRadioStyle}"
                                     GroupName="MainNav"
                                     IsChecked="{Binding IsHomeSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Home}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.75"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      Margin="0,0,12,0" />
                                <TextBlock Text="Stage" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource RailNavRadioStyle}"
                                     GroupName="MainNav"
                                     IsChecked="{Binding IsDevicesSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Headphones}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.75"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      Margin="0,0,12,0" />
                                <TextBlock Text="Outputs" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource RailNavRadioStyle}"
                                     GroupName="MainNav"
                                     IsChecked="{Binding IsSettingsSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Settings}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.65"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      Margin="0,0,12,0" />
                                <TextBlock Text="Preferences" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Active View Host with Custom Caption Bar + Warm Ambient Glow -->
            <Grid Grid.Column="1" Background="{StaticResource Brush.Canvas.Primary}">
                <Rectangle Fill="{StaticResource Brush.Canvas.AmbientGlow}" IsHitTestVisible="False" />

                <!-- Custom Window Controls -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,14,16,0"
                            Panel.ZIndex="10">
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            Content="─"
                            ToolTip="Minimize"
                            Click="OnMinimizeClick" />
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            Content="□"
                            ToolTip="Maximize / Restore"
                            Click="OnMaximizeClick"
                            Margin="3,0" />
                    <Button Style="{StaticResource CloseCaptionButtonStyle}"
                            Content="✕"
                            ToolTip="Close to Tray"
                            Click="OnCloseClick" />
                </StackPanel>

                <views:HomeView Visibility="{Binding IsHomeSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                <views:DevicesView DataContext="{Binding DevicesViewModel}"
                                   Visibility="{Binding DataContext.IsDevicesSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}" />
                <views:SettingsView DataContext="{Binding SettingsViewModel}"
                                    Visibility="{Binding DataContext.IsSettingsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Grid>
    </Border>
</Window>
