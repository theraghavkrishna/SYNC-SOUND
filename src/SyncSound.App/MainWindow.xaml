<Window x:Class="SyncSound.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:SyncSound.App.Views"
        xmlns:vm="clr-namespace:SyncSound.App.ViewModels"
        Title="SYNC SOUND"
        Icon="Assets/SyncSound.ico"
        Width="1040"
        Height="660"
        MinWidth="840"
        MinHeight="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            CornerRadius="22"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
            <views:DevicesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Secondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Canvas.Subtle}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
                                <Setter Property="Foreground" Value="#FCFBF8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8"
            CornerRadius="22"
            Background="{DynamicResource Brush.Canvas.Primary}"
            BorderBrush="{DynamicResource Brush.Border.Hairline}"
            BorderThickness="1.2"
            ClipToBounds="True"
            Effect="{DynamicResource Shadow.Window}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Compact Navigation Rail -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.Surface.Rail}"
                    BorderBrush="{DynamicResource Brush.Border.Hairline}"
                    BorderThickness="0,0,1,0"
                    Padding="16,22,16,18">
                <DockPanel>
                    <!-- Crisp Vector Logo Lockup -->
                    <StackPanel DockPanel.Dock="Top" Margin="4,4,0,26">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="32"
                                    Height="32"
                                    CornerRadius="9"
                                    Background="{DynamicResource Brush.Surface.SignatureCard}"
                                    BorderBrush="#2CF4EFE6"
                                    BorderThickness="1"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="2.2" Height="7" CornerRadius="1.1" Background="{DynamicResource Brush.Accent.Primary}" Margin="1,0" />
                                    <Border Width="2.2" Height="13" CornerRadius="1.1" Background="{DynamicResource Brush.Accent.Hover}" Margin="1,0" />
                                    <Border Width="2.2" Height="18" CornerRadius="1.1" Background="#F4EFE6" Margin="1,0" />
                                    <Border Width="2.2" Height="13" CornerRadius="1.1" Background="{DynamicResource Brush.Accent.Hover}" Margin="1,0" />
                                    <Border Width="2.2" Height="7" CornerRadius="1.1" Background="{DynamicResource Brush.Accent.Primary}" Margin="1,0" />
                                </StackPanel>
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SYNC SOUND"
                                           FontFamily="{StaticResource Font.Display}"
                                           FontSize="14.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Ink.Primary}" />
                                <TextBlock Text="Everyone listening."
                                           FontFamily="{StaticResource Font.Editorial}"
                                           FontStyle="Italic"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource Brush.Ink.Secondary}"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Footer Connection Summary -->
                    <Border DockPanel.Dock="Bottom"
                            Style="{StaticResource SurfaceCardStyle}"
                            CornerRadius="14"
                            Padding="12,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7.5" Height="7.5" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Ink.Muted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasConnectedDevices}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Status.Success}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSharing}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Accent.Primary}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding FooterConnectionText}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Ink.Primary}" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedCountText}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Brush.Ink.Muted}"
                                       Margin="15,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Primary 3 Destinations -->
                    <StackPanel Margin="0,4,0,0">
                        <RadioButton Style="{StaticResource RailNavRadioStyle}"
                                     GroupName="MainNav"
                                     IsChecked="{Binding IsHomeSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Listen}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.75"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      Margin="0,0,10,0" />
                                <TextBlock Text="Listen" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource RailNavRadioStyle}"
                                     GroupName="MainNav"
                                     IsChecked="{Binding IsDevicesSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Headphones}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.75"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      Margin="0,0,10,0" />
                                <TextBlock Text="Headphones" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource RailNavRadioStyle}"
                                     GroupName="MainNav"
                                     IsChecked="{Binding IsSettingsSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Settings}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.65"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      Margin="0,0,10,0" />
                                <TextBlock Text="Preferences" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Active View Host with Crisp Vector Window Controls -->
            <Grid Grid.Column="1" Background="{DynamicResource Brush.Canvas.Primary}">
                <Rectangle Fill="{DynamicResource Brush.Canvas.AmbientGlow}" IsHitTestVisible="False" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,12,14,0"
                            Panel.ZIndex="10">
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            ToolTip="Minimize"
                            Click="OnMinimizeClick">
                        <Path Data="{StaticResource Icon.WinMinimize}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            ToolTip="Maximize / Restore"
                            Click="OnMaximizeClick"
                            Margin="3,0">
                        <Path Data="{StaticResource Icon.WinMaximize}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButtonStyle}"
                            ToolTip="Close"
                            Click="OnCloseClick">
                        <Path Data="{StaticResource Icon.WinClose}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <views:HomeView Visibility="{Binding IsHomeSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                <views:DevicesView DataContext="{Binding DevicesViewModel}"
                                   Visibility="{Binding DataContext.IsDevicesSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}" />
                <views:SettingsView DataContext="{Binding SettingsViewModel}"
                                    Visibility="{Binding DataContext.IsSettingsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Grid>
    </Border>
</Window>
