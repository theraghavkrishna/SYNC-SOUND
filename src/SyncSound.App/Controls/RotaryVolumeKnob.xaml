<UserControl x:Class="SyncSound.App.Controls.RotaryVolumeKnob"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="KnobRoot"
             Width="48"
             Height="58"
             Cursor="Hand"
             ToolTip="Drag up/down or scroll to adjust device volume. Double-click to reset to 100%."
             MouseLeftButtonDown="OnMouseLeftButtonDown"
             MouseMove="OnMouseMove"
             MouseLeftButtonUp="OnMouseLeftButtonUp"
             MouseWheel="OnMouseWheel"
             LostMouseCapture="OnLostMouseCapture">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="DialHost"
              Grid.Row="0"
              Width="44"
              Height="44"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <!-- Background 270-degree Track Arc -->
            <Path x:Name="TrackArc"
                  Stroke="#26FFFFFF"
                  StrokeThickness="3.2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />

            <!-- Active Glowing Value Arc -->
            <Path x:Name="ValueArc"
                  Stroke="{StaticResource Brush.Accent.Primary}"
                  StrokeThickness="3.2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.65" Color="#22D3EE" />
                </Path.Effect>
            </Path>

            <!-- Tactile Elevated Dial Cap -->
            <Ellipse Width="28"
                     Height="28"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Stroke="#2AFFFFFF"
                     StrokeThickness="1">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#232A3B" Offset="0" />
                        <GradientStop Color="#121622" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.55" Color="#000000" />
                </Ellipse.Effect>
            </Ellipse>

            <!-- Rotating Indicator Tick -->
            <Grid Width="28"
                  Height="28"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="IndicatorRotation" Angle="-135" />
                </Grid.RenderTransform>
                <Border Width="2.5"
                        Height="7"
                        CornerRadius="1.25"
                        Background="{StaticResource Brush.Accent.Primary}"
                        VerticalAlignment="Top"
                        Margin="0,3.5,0,0" />
            </Grid>
        </Grid>

        <!-- Percentage Readout -->
        <TextBlock x:Name="PercentLabel"
                   Grid.Row="1"
                   Text="100%"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource Brush.Ink.Secondary}"
                   HorizontalAlignment="Center"
                   Margin="0,1,0,0" />
    </Grid>
</UserControl>
