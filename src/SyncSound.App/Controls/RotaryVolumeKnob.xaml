<UserControl x:Class="SyncSound.App.Controls.RotaryVolumeKnob"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="KnobRoot"
             Width="48"
             Height="58"
             Cursor="Hand"
             ToolTip="Drag up/down or scroll to adjust device volume. Double-click to reset to 100%."
             MouseLeftButtonDown="OnMouseLeftButtonDown"
             MouseMove="OnMouseMove"
             MouseLeftButtonUp="OnMouseLeftButtonUp"
             MouseWheel="OnMouseWheel"
             LostMouseCapture="OnLostMouseCapture">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="DialHost"
              Grid.Row="0"
              Width="44"
              Height="44"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <!-- Background 270-degree Track Arc -->
            <Path x:Name="TrackArc"
                  Stroke="{DynamicResource Brush.Surface.ControlTrack}"
                  StrokeThickness="3.2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />

            <!-- Active Burnt Orange Value Arc -->
            <Path x:Name="ValueArc"
                  Stroke="{DynamicResource Brush.Accent.Primary}"
                  StrokeThickness="3.2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />

            <!-- Tactile Dial Cap -->
            <Ellipse Width="28"
                     Height="28"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="{DynamicResource Brush.Surface.DialCap}"
                     Stroke="{DynamicResource Brush.Border.Hairline}"
                     StrokeThickness="1"
                     Effect="{DynamicResource Shadow.Dial}" />

            <!-- Rotating Burnt Orange Indicator Tick -->
            <Grid Width="28"
                  Height="28"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="IndicatorRotation" Angle="-135" />
                </Grid.RenderTransform>
                <Border Width="2.5"
                        Height="7"
                        CornerRadius="1.25"
                        Background="{DynamicResource Brush.Accent.Primary}"
                        VerticalAlignment="Top"
                        Margin="0,3.5,0,0" />
            </Grid>
        </Grid>

        <!-- Percentage Readout -->
        <TextBlock x:Name="PercentLabel"
                   Grid.Row="1"
                   Text="100%"
                   FontFamily="{StaticResource Font.Mono}"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Ink.Secondary}"
                   HorizontalAlignment="Center"
                   Margin="0,1,0,0" />
    </Grid>
</UserControl>
